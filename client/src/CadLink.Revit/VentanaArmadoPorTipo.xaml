<Window x:Class="CadLink.Revit.VentanaArmadoPorTipo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Armar por tipo: secciones de CadLink en los tipos de Revit"
        Height="760" Width="1080"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        MinHeight="420" MinWidth="820">

    <!-- Un renglon por TIPO de columna o de trabe que tiene piezas en el proyecto. A cada uno
         se le elige la seccion de la tabla de CadLink, y al pulsar Armar se arman TODAS sus
         piezas de un jalon.

         Esta ventana no decide nada: la sugerencia, lo que se puede marcar y el resumen viven
         en VistaArmadoPorTipo, en el nucleo, que tiene pruebas. Aqui solo se enlaza. -->

    <Window.Resources>
        <Style x:Key="Celda" TargetType="ComboBox">
            <Setter Property="Margin" Value="2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="150" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="0.7*" MinHeight="110" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                   Text="Elige la sección de CadLink de cada tipo de Revit. Se arman todas sus piezas a la vez:" />

        <TextBlock Grid.Row="1" Margin="0,6,0,10" TextWrapping="Wrap" Foreground="#555"
                   x:Name="ResumenText" />

        <DataGrid Grid.Row="2" x:Name="Reja"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  RowHeight="30"
                  SelectionMode="Single">

            <DataGrid.Columns>
                <!-- Plantilla y no DataGridCheckBoxColumn: la de la reja pide DOS clics, uno
                     para entrar en la celda y otro para marcar. -->
                <DataGridTemplateColumn Header="Armar" Width="55" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                      IsChecked="{Binding Armar, Mode=TwoWay,
                                                  UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Categoría" Width="80"
                                    Binding="{Binding Categoria}" IsReadOnly="True" />

                <DataGridTextColumn Header="Familia" Width="200"
                                    Binding="{Binding Familia}" IsReadOnly="True" />

                <DataGridTextColumn Header="Tipo de Revit" Width="160"
                                    Binding="{Binding NombreTipo}" IsReadOnly="True" />

                <DataGridTextColumn Header="Medidas (cm)" Width="95"
                                    Binding="{Binding Medidas}" IsReadOnly="True" />

                <DataGridTextColumn Header="Piezas" Width="55"
                                    Binding="{Binding Piezas}" IsReadOnly="True" />

                <DataGridTextColumn Header="De concreto" Width="80"
                                    Binding="{Binding DeConcreto}" IsReadOnly="True" />

                <!-- IsReadOnly en la columna del desplegable, como en el cuadro de mapeo: sin
                     eso la reja rehace la celda al empezar a editar y la eleccion se pierde. -->
                <DataGridTemplateColumn Header="Sección de CadLink" Width="150" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox Style="{StaticResource Celda}"
                                      ItemsSource="{Binding Secciones}"
                                      SelectedItem="{Binding Seccion, Mode=TwoWay,
                                                     UpdateSourceTrigger=PropertyChanged}"
                                      ToolTip="{Binding Diagnostico}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Notas" Width="*"
                                    Binding="{Binding Diagnostico}" IsReadOnly="True" />
            </DataGrid.Columns>

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <!-- Lo que se va a armar, en verde claro. -->
                        <DataTrigger Binding="{Binding Armar}" Value="True">
                            <Setter Property="Background" Value="#EEF8EE" />
                        </DataTrigger>

                        <!-- La seccion elegida no mide lo que el tipo: en ambar. -->
                        <DataTrigger Binding="{Binding Coherente}" Value="False">
                            <Setter Property="Background" Value="#FFF3D6" />
                        </DataTrigger>

                        <!-- Sin piezas de concreto no se puede armar: en gris. -->
                        <DataTrigger Binding="{Binding DeConcreto}" Value="0">
                            <Setter Property="Foreground" Value="#999" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>

        <GridSplitter Grid.Row="3" Height="6" HorizontalAlignment="Stretch" Margin="0,4,0,0"
                      Background="Transparent" ResizeDirection="Rows" />

        <!-- LA TABLA DE ARMADURAS. Una oficina maneja varios tipos de armadura por diametro
             -«VAR #4C TRABES», «VAR #4C COLUMNAS/CASTILLOS», «VAR #4C BASTON»...- y aqui se
             elige cual va en cada uso. Sale sola de las secciones marcadas arriba, con lo de
             la vez pasada o lo que mejor se llama. -->
        <TextBlock Grid.Row="4" Margin="0,6,0,6" FontWeight="SemiBold" TextWrapping="Wrap"
                   Text="Tipo de armadura de Revit con que se pone cada varilla:" />

        <DataGrid Grid.Row="5" x:Name="RejaVarillas"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  RowHeight="30"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Varilla" Width="260"
                                    Binding="{Binding Descripcion}" IsReadOnly="True" />

                <DataGridTemplateColumn Header="Tipo de armadura de Revit" Width="360" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox Style="{StaticResource Celda}"
                                      ItemsSource="{Binding Opciones}"
                                      SelectedItem="{Binding Elegido, Mode=TwoWay,
                                                     UpdateSourceTrigger=PropertyChanged}"
                                      ToolTip="Automático: el que se llame como la varilla o tenga su diámetro; si no hay, se crea." />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Notas" Width="*"
                                    Binding="{Binding Origen}" IsReadOnly="True" />
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="6" Margin="0,12,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Marcar todas" Padding="12,6" Margin="0,0,8,0"
                    Click="OnMarcarTodas"
                    ToolTip="Marca todos los tipos que tienen sección elegida y piezas de concreto." />
            <Button DockPanel.Dock="Left" Content="Desmarcar todas" Padding="12,6"
                    Click="OnDesmarcarTodas" />

            <CheckBox DockPanel.Dock="Left" x:Name="PropiedadesChk" IsChecked="True"
                      VerticalAlignment="Center" Margin="18,0,0,0"
                      Content="Escribir propiedades de tipo"
                      ToolTip="En cada tipo armado: Código de montaje = sus varillas («4 vars. #3C»), Nota clave = CONCRETO,&#10;Modelo = «15 X 30 CM», Descripción = el ID de CadLink, Marca de tipo = el elemento (TRABE, CASTILLO...).&#10;La etiqueta los lee: para cambiar lo que dice el plano, edita las propiedades de tipo." />

            <CheckBox DockPanel.Dock="Left" x:Name="DespieceChk" IsChecked="True"
                      VerticalAlignment="Center" Margin="14,0,0,0"
                      Content="Crear el despiece (cortes en una hoja)"
                      ToolTip="Un corte por sección a escala 1:10, con las llamadas de sus lechos («2 vars. #3C») y su etiqueta,&#10;acomodados en la hoja «DESPIECE DE SECCIONES - CadLink»." />

            <Button DockPanel.Dock="Right" Content="Cancelar" Padding="16,6" IsCancel="True" />
            <Button DockPanel.Dock="Right" x:Name="ArmarButton" Content="Armar"
                    Padding="20,6" Margin="0,0,8,0" IsDefault="True" Click="OnArmar"
                    ToolTip="Arma todas las piezas de los tipos marcados. Un solo Ctrl+Z lo deshace todo." />
        </DockPanel>
    </Grid>
</Window>
