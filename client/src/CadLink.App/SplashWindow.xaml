<Window x:Class="CadLink.App.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CadLink"
        Width="560" Height="300"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True">

    <!-- Margen exterior para que la sombra no quede recortada por el borde de la ventana -->
    <Border Margin="16"
            Background="{StaticResource SurfaceBrush}"
            CornerRadius="8"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="3" Opacity="0.28" Color="#FF000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ============ Zona principal: logo + identidad ============ -->
            <Grid Grid.Row="0" Margin="28,26,28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- El logo se asigna en el code-behind: sale del archivo indicado en
                     cadlink.config.json, o del embebido si ahi no hay ninguno. -->
                <Image Grid.Column="0"
                       x:Name="LogoImage"
                       Width="104" Height="104"
                       VerticalAlignment="Top"
                       RenderOptions.BitmapScalingMode="HighQuality" />

                <StackPanel Grid.Column="1" Margin="22,4,0,0">
                    <TextBlock x:Name="ProductNameText"
                               Text="CadLink"
                               FontSize="30"
                               FontWeight="Light"
                               Foreground="{StaticResource BrandDarkBrush}" />

                    <TextBlock x:Name="TaglineText"
                               Text="Excel · ETAP · AutoCAD"
                               FontSize="13"
                               Margin="0,2,0,0"
                               Foreground="{StaticResource BrandBrush}" />

                    <TextBlock x:Name="CompanyText"
                               Text=""
                               FontSize="12"
                               Margin="0,12,0,0"
                               Foreground="{StaticResource MutedTextBrush}" />

                    <TextBlock x:Name="VersionText"
                               Text="Versión 1.0.0"
                               FontSize="11"
                               Margin="0,2,0,0"
                               Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
            </Grid>

            <!-- ============ Zona inferior: estado y progreso ============ -->
            <StackPanel Grid.Row="1" Margin="28,18,28,22">
                <ProgressBar x:Name="Progress"
                             Height="3"
                             IsIndeterminate="True"
                             Background="#FFEDF1F5"
                             Foreground="{StaticResource BrandBrush}"
                             BorderThickness="0" />

                <TextBlock x:Name="StatusText"
                           Text="Iniciando…"
                           FontSize="11.5"
                           Margin="0,10,0,0"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource MutedTextBrush}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
