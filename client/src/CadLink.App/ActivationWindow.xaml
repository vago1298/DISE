<Window x:Class="CadLink.App.ActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Activación"
        Width="620" Height="470"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource SurfaceBrush}">

    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Encabezado con logo -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,18">
            <Image x:Name="LogoImage"
                   Width="52" Height="52"
                   VerticalAlignment="Top"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel Margin="14,2,0,0">
                <TextBlock Text="Activación de licencia" Style="{StaticResource ModuleTitleStyle}" />
                <TextBlock x:Name="ReasonText"
                           Style="{StaticResource ModuleSubtitleStyle}"
                           Margin="0"
                           MaxWidth="470"
                           Text="Este equipo necesita activarse para usar el programa." />
            </StackPanel>
        </StackPanel>

        <!-- Huella del equipo -->
        <Border Grid.Row="1"
                Background="#FFF3F6F9"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="14"
                Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="Huella de este equipo"
                           FontWeight="SemiBold"
                           FontSize="12"
                           Foreground="{StaticResource TextBrush}" />
                <TextBlock Text="Si eres trabajador de la empresa, envía esta huella a sistemas para que autorice tu equipo."
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,2,0,8"
                           Foreground="{StaticResource MutedTextBrush}" />

                <TextBox x:Name="FingerprintBox"
                         IsReadOnly="True"
                         FontFamily="Consolas"
                         FontSize="11.5"
                         TextWrapping="Wrap"
                         BorderThickness="0"
                         Background="Transparent"
                         Foreground="{StaticResource BrandDarkBrush}" />

                <Button x:Name="CopyButton"
                        Content="Copiar huella"
                        Style="{StaticResource SecondaryButtonStyle}"
                        HorizontalAlignment="Left"
                        Margin="0,10,0,0"
                        Click="OnCopyFingerprint" />
            </StackPanel>
        </Border>

        <!-- Clave de licencia -->
        <StackPanel Grid.Row="2" Margin="0,0,0,14">
            <TextBlock Text="Clave de licencia (clientes externos)"
                       FontWeight="SemiBold"
                       FontSize="12"
                       Margin="0,0,0,6"
                       Foreground="{StaticResource TextBrush}" />

            <TextBox x:Name="LicenseKeyBox"
                     Height="34"
                     FontFamily="Consolas"
                     FontSize="14"
                     Padding="8,0"
                     VerticalContentAlignment="Center"
                     CharacterCasing="Upper"
                     MaxLength="19"
                     BorderBrush="{StaticResource BorderBrush}" />

            <TextBlock Text="Formato: XXXX-XXXX-XXXX-XXXX"
                       FontSize="10.5"
                       Margin="0,4,0,0"
                       Foreground="{StaticResource MutedTextBrush}" />
        </StackPanel>

        <!-- Botones de acción -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="ActivateButton"
                    Content="Activar con clave"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="OnActivateWithKey" />

            <Button x:Name="AutoButton"
                    Content="Reintentar activación automática"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="OnActivateAutomatically" />
        </StackPanel>

        <!-- Mensajes -->
        <TextBlock x:Name="MessageText"
                   Grid.Row="4"
                   TextWrapping="Wrap"
                   FontSize="12"
                   VerticalAlignment="Top"
                   Foreground="{StaticResource DangerBrush}" />

        <!-- Pie -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock x:Name="SupportText"
                       FontSize="11"
                       VerticalAlignment="Center"
                       Margin="0,0,14,0"
                       Foreground="{StaticResource MutedTextBrush}" />
            <Button Content="Salir"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0"
                    Click="OnCancel" />
        </StackPanel>
    </Grid>
</Window>
