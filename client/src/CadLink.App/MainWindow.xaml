<Window x:Class="CadLink.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:CadLink.App.Models"
        Title="CadLink"
        Width="1240" Height="760"
        MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        FontFamily="{StaticResource FuenteUI}"
        FontSize="12.5"
        Foreground="{DynamicResource TextBrush}">

    <!-- Los atajos de siempre. Estaban prometidos en los ToolTip de los botones
         pero no existian: escribir Ctrl+G no hacia nada. -->
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="ApplicationCommands.New" />

        <!-- DESHACER. El manejador mira primero si el cursor esta dentro de una
             celda: ahi Ctrl+Z es el deshacer del cuadro de texto, letra por letra,
             y ese gana. El historial del trabajo entra cuando la celda ya no tiene
             nada que deshacer. Ver OnDeshacer. -->
        <KeyBinding Key="Z" Modifiers="Control" Command="ApplicationCommands.Undo" />
        <KeyBinding Key="G" Modifiers="Control" Command="ApplicationCommands.Save" />
        <KeyBinding Key="S" Modifiers="Control" Command="ApplicationCommands.Save" />
        <KeyBinding Key="G" Modifiers="Control+Shift" Command="ApplicationCommands.SaveAs" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="ApplicationCommands.SaveAs" />
        <KeyBinding Key="A" Modifiers="Control" Command="ApplicationCommands.Open" />
        <KeyBinding Key="O" Modifiers="Control" Command="ApplicationCommands.Open" />
    </Window.InputBindings>

    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.New"     Executed="OnNuevoTrabajo" />
        <CommandBinding Command="ApplicationCommands.Save"   Executed="OnGuardarTrabajo" />
        <CommandBinding Command="ApplicationCommands.SaveAs" Executed="OnGuardarComo" />
        <CommandBinding Command="ApplicationCommands.Open"   Executed="OnAbrirTrabajo" />
        <CommandBinding Command="ApplicationCommands.Undo"   Executed="OnDeshacer" />
    </Window.CommandBindings>

    <Grid>
        <!-- 4 filas: barra unica, aviso, hojas, barra de estado.
             Eran 6: se quito el cuadro azul de marca, y despues el menu y la barra
             de guardar se fusionaron en UNA sola fila. Cada fila que se va es alto
             util que ganan las hojas. -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== Barra unica ====================
             El menu y los botones de acceso rapido comparten UNA fila. Antes eran
             dos, una encima de la otra, y gastaban el doble de alto para ofrecer
             las mismas acciones: el menu con todo, y la barra con lo de siempre.

             El Menu va DENTRO de esta barra y no como control suelto para que los
             dos grupos queden alineados en la misma linea de base. -->
        <Border Grid.Row="0" Background="{DynamicResource TabStripBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="4,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

        <Menu Grid.Column="0" Background="Transparent" VerticalAlignment="Center">
            <MenuItem Header="_Archivo">
                <MenuItem Header="_Nuevo" Command="ApplicationCommands.New"
                          InputGestureText="Ctrl+N" />
                <Separator />
                <MenuItem Header="_Abrir trabajo..." Command="ApplicationCommands.Open"
                          InputGestureText="Ctrl+A" />
                <MenuItem Header="_Guardar trabajo" Command="ApplicationCommands.Save"
                          InputGestureText="Ctrl+G" />
                <MenuItem Header="Guardar _como..." Command="ApplicationCommands.SaveAs"
                          InputGestureText="Ctrl+Mayus+G" />
                <Separator />
                <MenuItem Header="_Deshacer" Command="ApplicationCommands.Undo"
                          InputGestureText="Ctrl+Z" />
                <Separator />
                <MenuItem Header="Cargar _ejemplo" Click="OnLoadSample" />
                <MenuItem Header="_Limpiar todo" Click="OnClearAll" />
                <Separator />
                <MenuItem Header="_Salir" Click="OnSalir" />
            </MenuItem>

            <MenuItem Header="_Dibujar">
                <MenuItem Header="_Revisar datos" Click="OnValidate" />
                <Separator />
                <MenuItem Header="Generar _dibujo de las secciones" Click="OnExport" />
                <MenuItem Header="Generar _alzados" Click="OnExportAlzados" />
                <MenuItem Header="Dibujar la _planta en AutoCAD" Click="OnDibujarPlantaCad" />
            </MenuItem>

            <!-- El menu no dice de que programa lee: eso lo manda la casilla de la
                 pestaña, y desde el menu se lee del que este elegido ahi. -->
            <MenuItem Header="_ETABS / SAP2000">
                <MenuItem Header="_Probar conexion" Click="OnTestEtabs" />
                <MenuItem Header="_Leer modelo" Click="OnImportModeloCsi" />
                <MenuItem Header="Leer _plantas" Click="OnLeerPlantas" />
                <MenuItem Header="Leer piers de _muros" Click="OnLeerPiers" />
            </MenuItem>

            <MenuItem Header="A_yuda">
                <MenuItem Header="_Revalidar la licencia" Click="OnRevalidate" />
                <MenuItem Header="_Copiar la huella del equipo" Click="OnCopyFingerprint" />
                <Separator />
                <MenuItem Header="_Acerca de..." Click="OnAcercaDe" />
            </MenuItem>
        </Menu>

                <!-- Separador entre el menu y los botones, para que no se lean como
                     un solo grupo. -->
                <Border Grid.Column="1" Style="{StaticResource ToolbarSeparatorStyle}"
                        Margin="8,4,6,4" />

                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <!-- NUEVO, ABRIR, GUARDAR Y GUARDAR COMO NO ESTAN AQUI.
                         Se pidio quitarlos de la barra: viven en el menu Archivo, con su
                         atajo -Ctrl+N, Ctrl+A, Ctrl+G, Ctrl+Mayus+G-, que es donde se
                         buscan y como se usan de verdad. Repetirlos aqui gastaba el ancho
                         de la barra en cuatro botones que ya estaban en el menu.

                         Los comandos siguen siendo los mismos -ApplicationCommands- asi
                         que los atajos de teclado funcionan igual, esten o no los botones. -->

                    <!-- DESHACER. Arranca apagado porque al abrir el programa no hay
                         nada que deshacer; lo enciende ActualizarBotonDeshacer en
                         cuanto hay un paso guardado, y su globo dice cuantos hay. -->
                    <Button x:Name="DeshacerButton" Content="Deshacer"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Click="OnDeshacer" IsEnabled="False"
                            ToolTip="No hay nada que deshacer." />

                    <Border Style="{StaticResource ToolbarSeparatorStyle}" />

                    <Button Content="Revisar datos" Style="{StaticResource ToolbarButtonStyle}"
                            Click="OnValidate"
                            ToolTip="Busca errores en lo capturado antes de dibujar." />

                    <!-- OJO: el separador va AUTO-CERRADO, con la barra al final de la
                         propia etiqueta. La comprobacion de la barra en
                         tools/validar.py toma el cuerpo con un regex NO CODICIOSO que
                         para en el primer cierre de Border que encuentra, asi que un
                         separador con contenido cortaria la barra en dos y el resto de
                         la comprobacion no veria ni este boton ni ArchivoText.
                         Por lo mismo, este comentario no escribe esa etiqueta. -->
                    <Border Style="{StaticResource ToolbarSeparatorStyle}" />

                    <!-- El texto dice A DONDE se va, no donde se esta: es lo que espera
                         quien pulsa un boton. Lo cambia OnCambiarTema. -->
                    <Button x:Name="TemaButton" Content="Tema oscuro"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Click="OnCambiarTema"
                            ToolTip="Cambia entre el tema claro y el oscuro. Se recuerda para la próxima vez." />

                    <!-- El nombre del archivo abierto, al final de la barra: es el
                         sitio donde se busca «en que estoy trabajando». -->
                    <TextBlock x:Name="ArchivoText" FontSize="11.5"
                               VerticalAlignment="Center"
                               Margin="16,0,6,0" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource MutedTextBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== Aviso ==================== -->
        <!-- El cuadro azul de marca que habia aqui SE QUITO. Ocupaba 54 px de alto
             permanentes para repetir el nombre del programa, que ya esta en la barra
             de titulo de la ventana, y la empresa, que tambien. Lo unico que no
             estaba en otro sitio era el estado de la licencia, y eso se fue a la
             barra de estado de abajo, que es su lugar. Esos 54 px son ahora alto
             util de las hojas. El logo sigue vivo: es el icono de la ventana. -->
        <Border x:Name="NoticeBar" Grid.Row="1"
                Background="{DynamicResource NoticeFondoBrush}" BorderBrush="{DynamicResource NoticeBordeBrush}" BorderThickness="0,0,0,1"
                Padding="16,8" Visibility="Collapsed">
            <TextBlock x:Name="NoticeText" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource NoticeTextoBrush}" />
        </Border>

        <!-- ==================== Hojas ==================== -->
        <TabControl x:Name="Sheets" Grid.Row="2"
                    Style="{StaticResource ExcelTabControlStyle}" Margin="8,6,8,0">

            <!-- ===== Proyecto ===== -->
            <TabItem Header="Proyecto">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="22">
                        <TextBlock Text="Datos del proyecto" Style="{StaticResource ModuleTitleStyle}"
                                   ToolTip="Los datos del juego de planos y su solapa." />

                        <!-- ===== Datos de la SOLAPA (el cuadro de rotulos) ===== -->
                        <TextBlock Text="Solapa de los planos" FontWeight="SemiBold" FontSize="12.5"
                                   Margin="0,24,0,2" Foreground="{DynamicResource BrandDarkBrush}" />
                        <TextBlock Style="{StaticResource ModuleSubtitleStyle}"
                                   Text="Lo que se imprime en el cuadro de rotulos de cada plano." />

                        <Grid Margin="0,4,0,0" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="330" />
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="250" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34" />
                                <RowDefinition Height="34" />
                                <RowDefinition Height="34" />
                                <RowDefinition Height="34" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Calculista:" VerticalAlignment="Center" />
                            <TextBox   Grid.Row="0" Grid.Column="1" x:Name="CalculistaBox" Height="26" VerticalContentAlignment="Center" />
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="Dibujo:" VerticalAlignment="Center" />
                            <TextBox   Grid.Row="0" Grid.Column="4" x:Name="DibujoBox" Height="26" VerticalContentAlignment="Center" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Propietario:" VerticalAlignment="Center" />
                            <TextBox   Grid.Row="1" Grid.Column="1" x:Name="PropietarioBox" Height="26" VerticalContentAlignment="Center" />
                            <TextBlock Grid.Row="1" Grid.Column="3" Text="Fecha:" VerticalAlignment="Center" />

                            <!-- El calendario se queda: sirve para elegir el dia. Pero lo
                                 que se ROTULA en la solapa es el mes y el ano con letra,
                                 y eso es lo que se ve al lado, que es el dato que de
                                 verdad sale impreso. -->
                            <StackPanel Grid.Row="1" Grid.Column="4" Orientation="Horizontal">
                                <DatePicker x:Name="FechaPicker" Height="26" Width="118"
                                            ToolTip="Elige el dia en el calendario. En la solapa se imprime el mes y el ano con letra." />
                                <TextBlock x:Name="FechaTextoLabel" VerticalAlignment="Center"
                                           Margin="10,0,0,0" FontWeight="SemiBold" FontSize="12"
                                           Foreground="{DynamicResource BrandDarkBrush}" />
                            </StackPanel>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Ubicacion:" VerticalAlignment="Center" />
                            <TextBox   Grid.Row="2" Grid.Column="1" x:Name="UbicacionBox" Height="26" VerticalContentAlignment="Center" />
                            <TextBlock Grid.Row="2" Grid.Column="3" Text="Escala:" VerticalAlignment="Center" />
                            <TextBox   Grid.Row="2" Grid.Column="4" x:Name="EscalaSolapaBox" Height="26" VerticalContentAlignment="Center" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Proyecto/Obra:" VerticalAlignment="Center" />
                            <TextBox   Grid.Row="3" Grid.Column="1" x:Name="ObraBox" Height="26" VerticalContentAlignment="Center" />
                            <TextBlock Grid.Row="3" Grid.Column="3" Text="Acotacion:" VerticalAlignment="Center" />
                            <ComboBox  Grid.Row="3" Grid.Column="4" x:Name="AcotacionCombo" Height="26">
                                <ComboBoxItem Content="cm" IsSelected="True" />
                                <ComboBoxItem Content="m" />
                                <ComboBoxItem Content="mm" />
                            </ComboBox>
                        </Grid>

                        <!-- ===== Juego de planos ===== -->
                        <TextBlock Text="Juego de planos" FontWeight="SemiBold" FontSize="12.5"
                                   Margin="0,22,0,2" Foreground="{DynamicResource BrandDarkBrush}" />
                        <TextBlock Style="{StaticResource ModuleSubtitleStyle}"
                                   Text="El numero de plano se pone solo: al agregar, quitar o reordenar se renumera todo el juego." />

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                            <Button Content="Agregar plano" Style="{StaticResource SecondaryButtonStyle}"
                                    Click="OnAgregarPlano" />
                            <Button Content="Quitar" Style="{StaticResource SecondaryButtonStyle}"
                                    Click="OnQuitarPlano" />
                            <Button Content="Subir" Style="{StaticResource SecondaryButtonStyle}"
                                    Click="OnSubirPlano" />
                            <Button Content="Bajar" Style="{StaticResource SecondaryButtonStyle}"
                                    Click="OnBajarPlano" />
                            <TextBlock x:Name="PlanosResumenText" FontSize="11.5" VerticalAlignment="Center"
                                       Margin="14,0,0,0" Foreground="{DynamicResource MutedTextBrush}" />
                        </StackPanel>

                        <!-- Se permite BORRAR con la tecla Supr. Agregar sigue siendo por el boton, para
                             que la clave y el numero se pongan solos. -->
                        <!-- SelectionUnit y SelectionMode van AQUI y no se heredan del
                             estilo, y es la razon por la que no se podian borrar varios
                             planos: SheetGridStyle pone SelectionUnit en CellOrRowHeader,
                             y con eso la tecla Supr actua sobre la CELDA, no sobre la
                             fila, asi que el DataGrid no borraba ninguna. Con FullRow y
                             Extended se pueden marcar varias filas y borrarlas de una. -->
                        <DataGrid x:Name="PlanosGrid" Style="{StaticResource SheetGridStyle}"
                                  Height="170" CanUserAddRows="False" CanUserDeleteRows="True"
                                  AutoGenerateColumns="False"
                                  SelectionUnit="FullRow" SelectionMode="Extended">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Clave plano" Binding="{Binding Clave}" Width="130" />
                                <DataGridTextColumn Header="Contiene" Binding="{Binding Contiene}" Width="*" MinWidth="240" />
                                <DataGridTextColumn Header="Escala" Binding="{Binding Escala}" Width="110" />
                                <!-- Solo lectura a proposito: el numero lo calcula el juego. -->
                                <DataGridTextColumn Header="No. Plano" Binding="{Binding NumeroTexto}"
                                                    Width="120" IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Guardar, abrir y crear un trabajo estan ARRIBA, en la
                             barra de la ventana, no aqui. Aqui solo queda lo que es
                             propio de esta hoja. -->
                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button Content="Cargar ejemplo" Style="{StaticResource PrimaryButtonStyle}" Click="OnLoadSample" />
                            <Button Content="Limpiar todo" Style="{StaticResource SecondaryButtonStyle}" Click="OnClearAll" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== Secciones de concreto ===== -->
            <TabItem Header="Secciones Concreto">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="230" />

                        <!-- Las notas del ultimo dibujo. Estaban ENCIMA de la vista
                             previa, en una capa semitransparente pegada abajo, y
                             tapaban justo la parte del dibujo donde va el rotulo.
                             Ahora van en su propio renglon, DEBAJO, y plegadas: si
                             no hay notas no ocupan nada, y si las hay se ve una
                             linea que se abre al tocarla. -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Secciones estructurales de concreto" Style="{StaticResource ModuleTitleStyle}"
                                   ToolTip="Las columnas ID, base, altura, lechos, estribo y gancho son las mismas de tu hoja. Las tres ultimas son calculadas: total de varillas, area de acero y cuantia." />

                        <!-- Equivale a la celda AC de la hoja: un solo estilo para
                             TODAS las secciones de la tabla. -->
                        <Border Style="{StaticResource TarjetaStyle}"
                                Padding="12,9" Margin="0,0,0,10"
                                HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Estilo de dibujo:" FontWeight="SemiBold" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,14,0"
                                           Foreground="{DynamicResource BrandDarkBrush}" />

                                <RadioButton x:Name="Tipo1Radio" GroupName="TipoSeccion" IsChecked="True"
                                             VerticalAlignment="Center" Margin="0,0,22,0"
                                             Checked="OnTipoSeccionCambiado">
                                    <TextBlock Text="Seccion tipo 1 - no rellena" FontWeight="SemiBold" FontSize="12" />
                                </RadioButton>

                                <RadioButton x:Name="Tipo2Radio" GroupName="TipoSeccion"
                                             VerticalAlignment="Center"
                                             Checked="OnTipoSeccionCambiado">
                                    <TextBlock Text="Seccion tipo 2 - rellena" FontWeight="SemiBold" FontSize="12" />
                                </RadioButton>

                                <Border Width="1" Background="{DynamicResource BorderBrush}"
                                        Margin="18,2,18,2" />

                                <TextBlock Text="Escala del hatch:" FontWeight="SemiBold" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,8,0"
                                           Foreground="{DynamicResource BrandDarkBrush}" />
                                <TextBox x:Name="HatchScaleBox" Text="0.0003" Width="90" Height="26"
                                         VerticalAlignment="Center" VerticalContentAlignment="Center"
                                         Padding="6,0"
                                         ToolTip="Tamaño del rayado AR-CONC. Sube el numero si se ve muy fino. Aplica a los dos tipos."
                                         LostFocus="OnEscalaHatchCambiada" />
                                <TextBlock Text="(sube el numero si se ve muy fino)"
                                           FontSize="10.5" VerticalAlignment="Center" Margin="8,0,0,0"
                                           Foreground="{DynamicResource MutedTextBrush}" />

                                <!-- La escala de DIBUJO ya no se captura: el dibujo sale
                                     siempre igual, asi que la casilla solo era una forma de
                                     descuadrarlo. El valor vive en
                                     MainWindow.EscalaDeDibujo, en un solo sitio. -->
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- FrozenColumnCount = paneles inmovilizados, como en Excel.
                         Elemento e ID se quedan pegados a la izquierda al desplazarse
                         hacia la derecha. Con 27 columnas, sin esto se pierde de vista
                         DE QUE FILA se está capturando en cuanto pasas de «N int sup»,
                         y se acaba escribiendo el armado en el renglón equivocado.
                         La fila de encabezado no se desplaza al bajar: el DataGrid la
                         mantiene fija de serie. -->
                    <DataGrid Grid.Row="1" x:Name="SeccionesGrid" Style="{StaticResource SheetGridStyle}"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              FrozenColumnCount="2"
                              HeadersVisibility="All"
                              EnableRowVirtualization="True"
                              ColumnHeaderStyle="{StaticResource EncabezadoHojaStyle}">
                        <DataGrid.Columns>
                            <!-- Las columnas de varilla son listas desplegables, como la
                                 validacion de datos de Excel. La lista se llena en el
                                 code-behind desde la tabla de diametros, asi que no puede
                                 desincronizarse con la validacion. -->
                            <DataGridComboBoxColumn x:Name="ColElemento" Header="Elemento"
                                                    SelectedItemBinding="{Binding Elemento, UpdateSourceTrigger=PropertyChanged}" Width="115"
                                                    ElementStyle="{StaticResource ComboCeldaMuestra}" EditingElementStyle="{StaticResource ComboCeldaEdicion}"
                                                    CellStyle="{StaticResource CeldaIdent}" />
                            <!-- ID: el PREFIJO va fijo y solo se edita el NUMERO.
                                 Si la trabe es T-01, al editar se cambia el 01 por el 02
                                 y el T- no se puede borrar. No se controla el cursor
                                 dentro de la celda —eso seria fragil— sino que el dato
                                 esta SEPARADO: PrefijoId de solo lectura y NumeroId
                                 editable. Ver SeccionConcretoRow.NumeroId.

                                 Y el caso OTRO sale gratis: alli no hay prefijo, asi que
                                 PrefijoId queda vacio, NumeroId vale el ID entero y se
                                 edita todo. El mismo mecanismo para los dos casos. -->
                            <DataGridTemplateColumn Header="ID" Width="90"
                                                    CellStyle="{StaticResource CeldaIdent}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Id}" Padding="4,2"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <!-- El prefijo, que NO se puede tocar -->
                                            <TextBlock Text="{Binding PrefijoId}"
                                                       VerticalAlignment="Center"
                                                       Padding="4,2,0,2"
                                                       Foreground="{DynamicResource MutedTextBrush}" />
                                            <!-- UpdateSourceTrigger=PropertyChanged: la
                                                 tabla y la vista previa se actualizan
                                                 mientras se escribe, no al salir. -->
                                            <TextBox Text="{Binding NumeroId, UpdateSourceTrigger=PropertyChanged}"
                                                     BorderThickness="0" MinWidth="40"
                                                     VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Base cm"    Binding="{Binding BaseCm, StringFormat=N1, UpdateSourceTrigger=PropertyChanged}" Width="75"
                                                    CellStyle="{StaticResource CeldaGeom}" />
                            <DataGridTextColumn Header="Altura cm"  Binding="{Binding AlturaCm, StringFormat=N1, UpdateSourceTrigger=PropertyChanged}" Width="80"
                                                    CellStyle="{StaticResource CeldaGeom}" />

                            <DataGridTextColumn Header="N esq sup"  Binding="{Binding NEsqSup, UpdateSourceTrigger=PropertyChanged}" Width="80"
                                                    CellStyle="{StaticResource CeldaLechoSup}" />
                            <DataGridComboBoxColumn x:Name="ColVarEsqSup" Header="Var esq sup"
                                                    SelectedItemBinding="{Binding DiamEsqSup, UpdateSourceTrigger=PropertyChanged}" Width="95"
                                                    ElementStyle="{StaticResource ComboCeldaMuestra}" EditingElementStyle="{StaticResource ComboCeldaEdicion}"
                                                    CellStyle="{StaticResource CeldaLechoSup}" />
                            <DataGridTextColumn Header="N int sup"  Binding="{Binding NIntSup, UpdateSourceTrigger=PropertyChanged}" Width="80"
                                                    CellStyle="{StaticResource CeldaLechoSup}" />
                            <DataGridComboBoxColumn x:Name="ColVarIntSup" Header="Var int sup"
                                                    SelectedItemBinding="{Binding DiamIntSup, UpdateSourceTrigger=PropertyChanged}" Width="95"
                                                    ElementStyle="{StaticResource ComboCeldaMuestra}" EditingElementStyle="{StaticResource ComboCeldaEdicion}"
                                                    CellStyle="{StaticResource CeldaLechoSup}" />

                            <DataGridTextColumn Header="N esq inf"  Binding="{Binding NEsqInf, UpdateSourceTrigger=PropertyChanged}" Width="80"
                                                    CellStyle="{StaticResource CeldaLechoInf}" />
                            <DataGridComboBoxColumn x:Name="ColVarEsqInf" Header="Var esq inf"
                                                    SelectedItemBinding="{Binding DiamEsqInf, UpdateSourceTrigger=PropertyChanged}" Width="95"
                                                    ElementStyle="{StaticResource ComboCeldaMuestra}" EditingElementStyle="{StaticResource ComboCeldaEdicion}"
                                                    CellStyle="{StaticResource CeldaLechoInf}" />
                            <DataGridTextColumn Header="N int inf"  Binding="{Binding NIntInf, UpdateSourceTrigger=PropertyChanged}" Width="80"
                                                    CellStyle="{StaticResource CeldaLechoInf}" />
                            <DataGridComboBoxColumn x:Name="ColVarIntInf" Header="Var int inf"
                                                    SelectedItemBinding="{Binding DiamIntInf, UpdateSourceTrigger=PropertyChanged}" Width="95"
                                                    ElementStyle="{StaticResource ComboCeldaMuestra}" EditingElementStyle="{StaticResource ComboCeldaEdicion}"
                                                    CellStyle="{StaticResource CeldaLechoInf}" />

                            <DataGridTextColumn Header="N lateral"  Binding="{Binding NInter, UpdateSourceTrigger=PropertyChanged}" Width="80"
                                                    CellStyle="{StaticResource CeldaLateral}" />
                            <DataGridComboBoxColumn x:Name="ColVarLateral" Header="Var lateral"
                                                    SelectedItemBinding="{Binding DiamInter, UpdateSourceTrigger=PropertyChanged}" Width="95"
                                                    ElementStyle="{StaticResource ComboCeldaMuestra}" EditingElementStyle="{StaticResource ComboCeldaEdicion}"
                                                    CellStyle="{StaticResource CeldaLateral}" />

                            <!-- ===== Seccion circular =====
                                 La FORMA se elige en la columna «Elemento», poniendo
                                 COLUMNA CIRCULAR. Aqui solo va su armado: en una fila
                                 circular la base es el DIAMETRO, la altura se ignora, y
                                 el acero se captura como TOTAL en lugar de por lechos.
                                 En el plano se rotula «COLUMNA», igual que una cuadrada. -->
                            <DataGridTextColumn Header="N total" Binding="{Binding NVarTotal, UpdateSourceTrigger=PropertyChanged}" Width="75"
                                                    CellStyle="{StaticResource CeldaCircular}" />
                            <DataGridComboBoxColumn x:Name="ColVarTotal" Header="Var total"
                                                    SelectedItemBinding="{Binding DiamVarTotal, UpdateSourceTrigger=PropertyChanged}" Width="95"
                                                    ElementStyle="{StaticResource ComboCeldaMuestra}" EditingElementStyle="{StaticResource ComboCeldaEdicion}"
                                                    CellStyle="{StaticResource CeldaCircular}" />
                            <DataGridComboBoxColumn x:Name="ColZuncho" Header="Zuncho helic."
                                                    SelectedItemBinding="{Binding ZunchoHelicoidal, UpdateSourceTrigger=PropertyChanged}" Width="100"
                                                    ElementStyle="{StaticResource ComboCeldaMuestra}" EditingElementStyle="{StaticResource ComboCeldaEdicion}"
                                                    CellStyle="{StaticResource CeldaCircular}" />

                            <DataGridTextColumn Header="Rec cm"     Binding="{Binding RecubrimientoCm, StringFormat=N1, UpdateSourceTrigger=PropertyChanged}" Width="70"
                                                    CellStyle="{StaticResource CeldaEstribo}" />
                            <DataGridComboBoxColumn x:Name="ColEstribo" Header="Estribo"
                                                    SelectedItemBinding="{Binding Estribo, UpdateSourceTrigger=PropertyChanged}" Width="85"
                                                    ElementStyle="{StaticResource ComboCeldaMuestra}" EditingElementStyle="{StaticResource ComboCeldaEdicion}"
                                                    CellStyle="{StaticResource CeldaEstribo}" />
                            <!-- Sep cm: desplegable con las separaciones de siempre, pero
                                 SIN cerrar la puerta a teclear otra.

                                 Va como DataGridTemplateColumn y no como
                                 DataGridComboBoxColumn a proposito. Un
                                 DataGridComboBoxColumn se enlaza por SelectedItemBinding,
                                 y con IsEditable lo que el usuario teclea a mano NO pasa
                                 al SelectedItem: se perderia al salir de la celda. Aqui el
                                 ComboBox se enlaza por Text, que recoge las dos cosas, lo
                                 elegido de la lista y lo escrito.

                                 La lista sale de SeccionConcretoRow.SeparacionesUsuales,
                                 un solo sitio, igual que los diametros salen de
                                 Varilla.DiametrosCm. -->
                            <DataGridTemplateColumn Header="Sep cm" Width="95"
                                                    CellStyle="{StaticResource CeldaEstribo}"
                                                    SortMemberPath="SeparacionCm">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SeparacionCm}"
                                                   Style="{StaticResource ComboCeldaLectura}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox IsEditable="True"
                                                  IsDropDownOpen="True"
                                                  BorderThickness="0"
                                                  Padding="2,0"
                                                  VerticalContentAlignment="Center"
                                                  ItemsSource="{Binding Source={x:Static models:SeccionConcretoRow.SeparacionesUsuales}}"
                                                  Text="{Binding SeparacionCm, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="Elige una de la lista o escribe la que necesites, por ejemplo 6-12-6 o 15.&#10;Los tramos se reparten como confinamiento, centro y confinamiento." />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridComboBoxColumn x:Name="ColDiamante" Header="Diamante"
                                                    SelectedItemBinding="{Binding EstriboDiamante, UpdateSourceTrigger=PropertyChanged}" Width="85"
                                                    ElementStyle="{StaticResource ComboCeldaMuestra}" EditingElementStyle="{StaticResource ComboCeldaEdicion}"
                                                    CellStyle="{StaticResource CeldaEstribo}" />
                            <DataGridComboBoxColumn x:Name="ColVarDiamante" Header="Var diam."
                                                    SelectedItemBinding="{Binding DiamEstriboDiamante, UpdateSourceTrigger=PropertyChanged}" Width="95"
                                                    ElementStyle="{StaticResource ComboCeldaMuestra}" EditingElementStyle="{StaticResource ComboCeldaEdicion}"
                                                    CellStyle="{StaticResource CeldaEstribo}" />
                            <DataGridTextColumn Header="Gancho cm"  Binding="{Binding GanchoCm, StringFormat=N1, UpdateSourceTrigger=PropertyChanged}" Width="85"
                                                    CellStyle="{StaticResource CeldaAcabado}" />
                            <DataGridTextColumn Header="f'c"        Binding="{Binding Fc, UpdateSourceTrigger=PropertyChanged}" Width="65"
                                                    CellStyle="{StaticResource CeldaAcabado}" />
                            <DataGridTextColumn Header="Escala"     Binding="{Binding Escala, UpdateSourceTrigger=PropertyChanged}" Width="65"
                                                    CellStyle="{StaticResource CeldaAcabado}" />
                            <DataGridTextColumn Header="Long. m"   Binding="{Binding LongitudM, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}" Width="80"
                                                    CellStyle="{StaticResource CeldaAcabado}" />

                            <DataGridTextColumn Header="Total vars." Binding="{Binding TotalVarillas, UpdateSourceTrigger=PropertyChanged}"
                                                IsReadOnly="True" Width="85"
                                                    CellStyle="{StaticResource CeldaCalculada}" />
                            <DataGridTextColumn Header="As cm2"      Binding="{Binding AreaAceroCm2, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}"
                                                IsReadOnly="True" Width="80"
                                                    CellStyle="{StaticResource CeldaCalculada}" />
                            <DataGridTextColumn Header="Cuantia %"   Binding="{Binding CuantiaPorcentaje, StringFormat=N3, UpdateSourceTrigger=PropertyChanged}"
                                                IsReadOnly="True" Width="85"
                                                    CellStyle="{StaticResource CeldaCalculada}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Style="{StaticResource BarraTotalesStyle}" Grid.Row="2"
                            >
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="TotalesText" Grid.Column="0"
                                       Style="{StaticResource TextoTotalesStyle}"
                                       VerticalAlignment="Center" />

                            <!-- El boton de dibujar vive aqui, junto a la tabla que
                                 dibuja, y no en una pestaña aparte. -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <!-- Sin esta casilla, una seccion ya dibujada no habia
                                     forma de actualizarla mas que purgando su bloque
                                     a mano en AutoCAD. -->
                                <CheckBox x:Name="RedibujarChk" VerticalAlignment="Center"
                                          Margin="0,0,14,0"
                                          Content="Redibujar las que ya existen"
                                          ToolTip="Apagado: la seccion que ya es bloque se salta, como DibujarSecciones de la macro.&#10;Encendido: se rehace EN SU MISMO SITIO, como ActualizarSecciones." />
                                <Button Content="Revisar datos" Style="{StaticResource SecondaryButtonStyle}"
                                        Click="OnValidate" />
                                <Button x:Name="AlzadosButton" Content="Generar alzados"
                                        Style="{StaticResource SecondaryButtonStyle}" Click="OnExportAlzados" />
                                <Button x:Name="ExportButton" Content="Generar dibujo"
                                        Style="{StaticResource PrimaryButtonStyle}" Click="OnExport" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Fondo AZUL, para que la vista previa se lea como un panel
                         aparte y no como una prolongacion en blanco de la tabla.
                         Es un azul CLARO a proposito: el dibujo va en tinta oscura
                         sobre concreto claro, asi que un azul fuerte dejaria las
                         varillas y las cotas sin contraste. -->
                    <Border Style="{StaticResource MarcoPreviaStyle}" Grid.Row="3"
                            >
                        <Grid>
                            <Canvas x:Name="PreviewCanvas"
                                    Background="{StaticResource PreviewFondoBrush}"
                                    ClipToBounds="True" />
                            <TextBlock Text="Vista previa de la seccion seleccionada"
                                       FontSize="10.5" Margin="8,6,0,0"
                                       VerticalAlignment="Top" HorizontalAlignment="Left"
                                       Foreground="{DynamicResource BrandDarkBrush}" />

                        </Grid>
                    </Border>

                    <!-- ===== NOTAS Y AVISOS DEL ULTIMO DIBUJO =====

                         FUERA DE LA VISTA PREVIA, y plegadas.

                         Estaban encima del dibujo, en una capa semitransparente
                         pegada al borde de abajo, y ahi tapaban justo lo que hay que
                         mirar: el rotulo de la seccion y la cota de la base. Con
                         cuatro o cinco notas -y el interop de AutoCAD deja cuatro
                         cada vez- se comian un tercio del cuadro.

                         Ahora van en su propio renglon, debajo, dentro de un
                         Expander PLEGADO: cuando hay notas se ve una sola linea que
                         se abre al tocarla, y cuando no hay no se ve nada. La vista
                         previa ya no se tapa nunca.

                         Se pliega SOLA cada vez que se dibuja -MostrarNotas la
                         cierra-, para que un dibujo nuevo no herede el panel abierto
                         del anterior. -->
                    <Border Grid.Row="4" Margin="0,8,0,0"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1">
                        <!-- La visibilidad la manda el TEXTO, con un disparador, y no
                             una linea de codigo: hay CUATRO sitios que escriben estas
                             notas, y con un Visibility puesto a mano habria que
                             acordarse de apagarlo en los cuatro. Asi aparece y
                             desaparece solo. -->
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Value=""
                                                 Binding="{Binding Text, ElementName=ExportHintText}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Expander x:Name="NotasPanel" IsExpanded="False" Padding="6,2"
                                  Foreground="{DynamicResource MutedTextBrush}">
                            <Expander.Header>
                                <TextBlock Text="Notas y avisos del último dibujo"
                                           FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrandDarkBrush}" />
                            </Expander.Header>
                            <ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="ExportHintText" FontSize="10.5"
                                           TextWrapping="Wrap" Margin="4,2,4,6"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                            </ScrollViewer>
                        </Expander>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ===== Secciones de acero ===== -->
            <TabItem Header="Secciones Acero">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Secciones estructurales de acero" Style="{StaticResource ModuleTitleStyle}"
                                   ToolTip="Las doce familias del manual IMCA en una sola tabla. Elige la familia y la celda Perfil te ofrece SOLO los perfiles de esa familia: la IR trae las W, y la IS, la IC y la S tienen cada una su propia lista. Al elegir un perfil sus medidas se traen solas, y cada familia usa las columnas que necesita y deja las demas en blanco." />

                        <Border Style="{StaticResource TarjetaStyle}"
                                Padding="12,9" Margin="0,0,0,10"
                                HorizontalAlignment="Left">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="Las doce familias:" FontWeight="SemiBold" FontSize="12"
                                               VerticalAlignment="Center" Margin="0,0,14,0"
                                               Foreground="{DynamicResource BrandDarkBrush}" />
                                    <TextBlock FontSize="11.5" VerticalAlignment="Center"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               Text="IR, IS, IC y S: perfil I  |  WT: te  |  C: canal laminada  |  CF: canal con labios (monten)  |  ZF: zeta  |  L: angulo  |  OR: tubo rectangular  |  OC: tubo redondo  |  OS: redondo macizo" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <DataGrid x:Name="AceroGrid" Grid.Row="1"
                              Style="{StaticResource SheetGridStyle}"
                              SelectionUnit="FullRow"
                              FrozenColumnCount="3"
                              HeadersVisibility="All"
                              EnableRowVirtualization="True"
                              RowStyle="{StaticResource FilaAceroStyle}"
                              ColumnHeaderStyle="{StaticResource EncabezadoHojaStyle}">
                        <DataGrid.Columns>
                            <DataGridComboBoxColumn x:Name="ColFamilia" Header="Familia"
                                                    SelectedItemBinding="{Binding Familia, UpdateSourceTrigger=PropertyChanged}" Width="75"
                                                    ElementStyle="{StaticResource ComboCeldaMuestra}" EditingElementStyle="{StaticResource ComboCeldaEdicion}"
                                                    CellStyle="{StaticResource CeldaIdent}" />

                            <!-- El nombre de catalogo. Al escribirlo se ajusta la familia
                                 sola si el nombre la delata: quien escribe HSS6X6X1/4 esta
                                 capturando un OR, y dibujarlo como IR daria un perfil I con
                                 las medidas de un tubo. Ver FamiliaPerfil.DelNombre. -->
                            <!-- Perfil: desplegable con los perfiles DE SU FAMILIA, y al
                                 elegir uno se traen sus medidas del catalogo. Asi no hay
                                 que teclear peralte, ancho y dos espesores por fila, que
                                 son cuatro oportunidades de equivocarse y un espesor mal
                                 escrito no se ve en el dibujo: sale un perfil creible con
                                 la medida equivocada.

                                 La lista sale de la FILA y no de la columna porque cada
                                 fila puede ser de otra familia. Y es editable, para poder
                                 capturar un perfil que no este en el catalogo. -->
                            <DataGridTemplateColumn Header="Perfil" Width="150"
                                                    CellStyle="{StaticResource CeldaIdent}"
                                                    SortMemberPath="Perfil">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Perfil}"
                                                   Style="{StaticResource ComboCeldaLectura}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox IsEditable="True"
                                                  IsDropDownOpen="True"
                                                  BorderThickness="0"
                                                  Padding="2,0"
                                                  VerticalContentAlignment="Center"
                                                  ItemsSource="{Binding PerfilesDeLaFamilia}"
                                                  Text="{Binding Perfil, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="Elige del catalogo y las medidas se llenan solas, o escribe un perfil que no este en la lista y captura sus medidas a mano." />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id, UpdateSourceTrigger=PropertyChanged}" Width="80"
                                                CellStyle="{StaticResource CeldaIdent}" />

                            <DataGridComboBoxColumn x:Name="ColElementoAcero" Header="Elemento"
                                                    SelectedItemBinding="{Binding Elemento, UpdateSourceTrigger=PropertyChanged}" Width="110"
                                                    ElementStyle="{StaticResource ComboCeldaMuestra}" EditingElementStyle="{StaticResource ComboCeldaEdicion}"
                                                    CellStyle="{StaticResource CeldaIdent}" />
                            <!-- Se pega al rotulo detras del elemento, sea cual sea: una
                                 DIAGONAL PRINCIPAL o un LARGUERO DE BORDE son cosas que se
                                 dicen en un plano. La macro solo lo hacia con la VIGA, y el
                                 resultado era que la clasificacion se elegia, se veia en la
                                 celda y luego no aparecia en el dibujo. -->
                            <DataGridComboBoxColumn x:Name="ColClasificacion" Header="Clasificación"
                                                    SelectedItemBinding="{Binding Clasificacion, UpdateSourceTrigger=PropertyChanged}" Width="110"
                                                    ElementStyle="{StaticResource ComboCeldaMuestra}" EditingElementStyle="{StaticResource ComboCeldaEdicion}"
                                                    CellStyle="{StaticResource CeldaIdent}" />

                            <DataGridTextColumn Header="Peralte cm" Binding="{Binding PeralteCm, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}" Width="90"
                                                CellStyle="{StaticResource CeldaGeom}" />
                            <DataGridTextColumn Header="Ancho cm" Binding="{Binding AnchoCm, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}" Width="85"
                                                CellStyle="{StaticResource CeldaGeom}" />
                            <DataGridTextColumn Header="e alma cm" Binding="{Binding EspesorAlmaCm, StringFormat=N3, UpdateSourceTrigger=PropertyChanged}" Width="90"
                                                CellStyle="{StaticResource CeldaGeom}" />
                            <DataGridTextColumn Header="e patin cm" Binding="{Binding EspesorPatinCm, StringFormat=N3, UpdateSourceTrigger=PropertyChanged}" Width="90"
                                                CellStyle="{StaticResource CeldaGeom}" />
                            <DataGridTextColumn Header="Labio cm" Binding="{Binding LabioCm, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}" Width="85"
                                                CellStyle="{StaticResource CeldaAcabado}" />
                            <DataGridTextColumn Header="r cm" Binding="{Binding RadioCm, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}" Width="70"
                                                CellStyle="{StaticResource CeldaAcabado}" />
                            <!-- Solo la ZF. Una zeta de catalogo tiene los dos patines de
                                 distinto ancho (60.3 y 54 mm en la de 2 3/8") y eso no es
                                 una errata del manual: es lo que permite traslapar dos
                                 zetas en el apoyo. En cero, la zeta sale simetrica. -->
                            <DataGridTextColumn Header="Ancho 2 cm" Binding="{Binding AnchoMenorCm, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}" Width="90"
                                                CellStyle="{StaticResource CeldaAcabado}" />

                            <DataGridCheckBoxColumn Header="Doble" Binding="{Binding Doble, UpdateSourceTrigger=PropertyChanged}" Width="60"
                                                    CellStyle="{StaticResource CeldaAcabado}" />
                            <!-- El acero: la lista sale del catalogo aceros.csv, que trae
                                 los 39 del manual con su Fy, su Fu y en que secciones se
                                 hace cada uno. Antes eran cinco escritos en el codigo.

                                 El globo de ayuda de la celda trae el detalle -Fy y Fu en
                                 kg/cm2 y en MPa, y la norma mexicana equivalente- para no
                                 tener que ir a buscarlo a la hoja. -->
                            <DataGridComboBoxColumn x:Name="ColAcero" Header="Acero"
                                                    SelectedItemBinding="{Binding Acero, UpdateSourceTrigger=PropertyChanged}" Width="135"
                                                    EditingElementStyle="{StaticResource ComboCeldaEdicion}"
                                                    CellStyle="{StaticResource CeldaAcabado}">
                                <!-- Esta columna SI trae su ElementStyle escrito, porque lleva
                                     ademas el globo de ayuda del acero. Hereda de
                                     ComboCeldaMuestra para no perder la tinta de la celda. -->
                                <DataGridComboBoxColumn.ElementStyle>
                                    <Style TargetType="ComboBox"
                                           BasedOn="{StaticResource ComboCeldaMuestra}">
                                        <Setter Property="ToolTip" Value="{Binding AceroDetalle}" />
                                    </Style>
                                </DataGridComboBoxColumn.ElementStyle>
                            </DataGridComboBoxColumn>

                            <!-- El Fy del acero, que es el dato con el que se revisa. Sale
                                 del catalogo, asi que es de solo lectura: se elige el acero,
                                 no se teclea su esfuerzo. -->
                            <DataGridTextColumn Header="Fy kg/cm²"
                                                Binding="{Binding FyKgCm2, StringFormat=N0}"
                                                IsReadOnly="True" Width="80"
                                                CellStyle="{StaticResource CeldaCalculada}" />

                            <!-- Y SI ESE ACERO SE CONSIGUE EN ESE PERFIL, que es lo que no
                                 se ve mirando la fila: un A-36 en un monten no existe -la
                                 lamina rolada en frio no se hace en A-36- y los dos valores
                                 son validos por separado.

                                 Tres respuestas, no dos: «Si», «Verificar» -puede pedirse,
                                 confirmalo- y «No se hace», que es la unica que pinta la
                                 fila. Ver CeldaDisponibilidadAcero. -->
                            <DataGridTextColumn Header="¿Se hace?"
                                                Binding="{Binding AceroDisponibleLeyenda}"
                                                IsReadOnly="True" Width="90"
                                                CellStyle="{StaticResource CeldaDisponibilidadAcero}" />

                            <!-- Calculadas. «Forma» es lo que se va a dibujar, y esta aqui
                                 para que se vea que cuatro familias distintas (IR, IS, IC y
                                 S) se dibujan igual y solo cambian de color y de nombre.
                                 «En el plano» es la traduccion a nomenclatura mexicana que
                                 hacen las macros al rotular (W a IR, HSS a OR, PIPE a OC), y
                                 «Falta» dice, para la forma elegida, que dimension no se
                                 sostiene. -->
                            <DataGridTextColumn Header="Forma" Binding="{Binding FormaNombre}"
                                                IsReadOnly="True" Width="120"
                                                CellStyle="{StaticResource CeldaCalculada}" />
                            <DataGridTextColumn Header="En el plano" Binding="{Binding PerfilRotulo}"
                                                IsReadOnly="True" Width="190"
                                                CellStyle="{StaticResource CeldaCalculada}" />
                            <DataGridTextColumn Header="Falta" Binding="{Binding FaltanDatos}"
                                                IsReadOnly="True" Width="220"
                                                CellStyle="{StaticResource CeldaCalculada}" />

                            <!-- ===== PROPIEDADES GEOMETRICAS, del manual IMCA =====

                                 Van al final y son de SOLO LECTURA: no se capturan ni se
                                 dibujan, se traen del catalogo con las medidas para poder
                                 comparar dos perfiles al elegir sin ir al manual.

                                 Se enlazan a un double? a proposito. Un hueco significa
                                 que el manual NO DA esa propiedad para esa familia -el
                                 redondo macizo no trae Sx, la canal formada en frio no
                                 trae rx- y eso no es cero: con cero la celda diria «0.00»
                                 y se leeria como un dato. Con nulo, sale vacia.

                                 El Ix y el Sx de las formadas en frio (CF y ZF) son los
                                 valores de DISEÑO por ancho efectivo, que es lo que da el
                                 manual para una lamina delgada. -->
                            <DataGridTextColumn Header="Peso kg/m" Binding="{Binding Propiedades.PesoKgM, StringFormat=N2}"
                                                IsReadOnly="True" Width="85"
                                                CellStyle="{StaticResource CeldaCalculada}" />
                            <DataGridTextColumn Header="Área cm²" Binding="{Binding Propiedades.AreaCm2, StringFormat=N2}"
                                                IsReadOnly="True" Width="85"
                                                CellStyle="{StaticResource CeldaCalculada}" />
                            <DataGridTextColumn Header="Ix cm⁴" Binding="{Binding Propiedades.IxCm4, StringFormat=N2}"
                                                IsReadOnly="True" Width="90"
                                                CellStyle="{StaticResource CeldaCalculada}" />
                            <DataGridTextColumn Header="Sx cm³" Binding="{Binding Propiedades.SxCm3, StringFormat=N2}"
                                                IsReadOnly="True" Width="85"
                                                CellStyle="{StaticResource CeldaCalculada}" />
                            <DataGridTextColumn Header="Zx cm³" Binding="{Binding Propiedades.ZxCm3, StringFormat=N2}"
                                                IsReadOnly="True" Width="85"
                                                CellStyle="{StaticResource CeldaCalculada}" />
                            <DataGridTextColumn Header="rx cm" Binding="{Binding Propiedades.RxCm, StringFormat=N2}"
                                                IsReadOnly="True" Width="75"
                                                CellStyle="{StaticResource CeldaCalculada}" />
                            <DataGridTextColumn Header="Iy cm⁴" Binding="{Binding Propiedades.IyCm4, StringFormat=N2}"
                                                IsReadOnly="True" Width="90"
                                                CellStyle="{StaticResource CeldaCalculada}" />
                            <DataGridTextColumn Header="Sy cm³" Binding="{Binding Propiedades.SyCm3, StringFormat=N2}"
                                                IsReadOnly="True" Width="85"
                                                CellStyle="{StaticResource CeldaCalculada}" />
                            <DataGridTextColumn Header="Zy cm³" Binding="{Binding Propiedades.ZyCm3, StringFormat=N2}"
                                                IsReadOnly="True" Width="85"
                                                CellStyle="{StaticResource CeldaCalculada}" />
                            <DataGridTextColumn Header="ry cm" Binding="{Binding Propiedades.RyCm, StringFormat=N2}"
                                                IsReadOnly="True" Width="75"
                                                CellStyle="{StaticResource CeldaCalculada}" />
                            <DataGridTextColumn Header="rmín cm" Binding="{Binding Propiedades.RminCm, StringFormat=N2}"
                                                IsReadOnly="True" Width="80"
                                                CellStyle="{StaticResource CeldaCalculada}" />
                            <DataGridTextColumn Header="J cm⁴" Binding="{Binding Propiedades.JCm4, StringFormat=N3}"
                                                IsReadOnly="True" Width="85"
                                                CellStyle="{StaticResource CeldaCalculada}" />
                            <DataGridTextColumn Header="Cw cm⁶" Binding="{Binding Propiedades.CwCm6, StringFormat=N1}"
                                                IsReadOnly="True" Width="95"
                                                CellStyle="{StaticResource CeldaCalculada}" />
                            <DataGridTextColumn Header="Ixy cm⁴" Binding="{Binding Propiedades.IxyCm4, StringFormat=N2}"
                                                IsReadOnly="True" Width="85"
                                                CellStyle="{StaticResource CeldaCalculada}" />
                            <DataGridTextColumn Header="x̄ cm" Binding="{Binding Propiedades.XbarCm, StringFormat=N2}"
                                                IsReadOnly="True" Width="70"
                                                CellStyle="{StaticResource CeldaCalculada}" />
                            <DataGridTextColumn Header="ȳ cm" Binding="{Binding Propiedades.YbarCm, StringFormat=N2}"
                                                IsReadOnly="True" Width="70"
                                                CellStyle="{StaticResource CeldaCalculada}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- ===== VISTA PREVIA DE LA FORMA =====

                         Igual que la del concreto, y por el mismo motivo: la tabla dice
                         numeros y el perfil se dibuja con una FORMA, asi que un espesor
                         mal capturado no se ve en la tabla pero si en el dibujo.

                         La geometria sale de TrazoAcero, que es el MISMO calculo que usa
                         el dibujante de AutoCAD. Una vista previa que calcula la forma por
                         su cuenta puede acabar enseñando algo distinto de lo que se
                         dibuja, que es justo lo que no puede hacer. -->
                    <Border Style="{StaticResource MarcoPreviaStyle}" Grid.Row="2" Height="240"
                            >
                        <Grid>
                            <Canvas x:Name="AceroPreviewCanvas"
                                    Background="{StaticResource PreviewFondoBrush}"
                                    ClipToBounds="True" />
                            <TextBlock Text="Vista previa del perfil seleccionado"
                                       FontSize="10.5" Margin="8,6,0,0"
                                       VerticalAlignment="Top" HorizontalAlignment="Left"
                                       Foreground="{DynamicResource BrandDarkBrush}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource BarraTotalesStyle}" Grid.Row="3"
                            >
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="TotalesAceroText" Grid.Column="0"
                                       Style="{StaticResource TextoTotalesStyle}"
                                       VerticalAlignment="Center" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <CheckBox x:Name="RedibujarAceroChk" VerticalAlignment="Center"
                                          Margin="0,0,14,0"
                                          Content="Redibujar las que ya existen"
                                          ToolTip="Apagado: el perfil que ya es bloque se salta.&#10;Encendido: se rehace EN SU MISMO SITIO." />
                                <Button x:Name="AceroButton" Content="Generar dibujo de acero"
                                        Style="{StaticResource PrimaryButtonStyle}" Click="OnExportAcero" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ===== Zapatas corridas ===== -->
            <TabItem Header="Zapatas Corridas">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="300" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Zapatas corridas" Style="{StaticResource ModuleTitleStyle}"
                                   ToolTip="Las columnas son las celdas de tus dos macros de zapata corrida. La de TIPO decide lo que cambia entre ellas: la CENTRAL lleva el muro centrado y las secciones crecen a la derecha; la de LINDERO lleva el muro pegado al paño derecho y crecen a la izquierda, y ahi las patas del acero del muro doblan las dos a la izquierda y a dos alturas, porque por la derecha esta el lindero." />

                        <!-- EL ESTILO DE DIBUJO ES DEL JUEGO ENTERO, igual que en las
                             aisladas: son los MISMOS botones de la hoja de concreto,
                             atados por ElementName. La celda B3 de tus macros. -->
                        <Border Style="{StaticResource TarjetaStyle}"
                                Padding="12,9" Margin="0,0,0,8"
                                HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Estilo de dibujo:" FontWeight="SemiBold" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,14,0"
                                           Foreground="{DynamicResource BrandDarkBrush}" />

                                <RadioButton x:Name="ZapCorTipo1Radio" GroupName="TipoSeccionZapataCorrida"
                                             VerticalAlignment="Center" Margin="0,0,22,0"
                                             IsChecked="{Binding IsChecked, ElementName=Tipo1Radio, Mode=TwoWay}">
                                    <TextBlock Text="Seccion tipo 1 - no rellena" FontWeight="SemiBold" FontSize="12" />
                                </RadioButton>

                                <RadioButton x:Name="ZapCorTipo2Radio" GroupName="TipoSeccionZapataCorrida"
                                             VerticalAlignment="Center"
                                             IsChecked="{Binding IsChecked, ElementName=Tipo2Radio, Mode=TwoWay}">
                                    <TextBlock Text="Seccion tipo 2 - rellena" FontWeight="SemiBold" FontSize="12" />
                                </RadioButton>

                                <TextBlock Text="Con relleno, el muro de enrase sale con sus blocks en solido y sus juntas en otro color, como en tu macro."
                                           FontSize="11" Opacity="0.75" VerticalAlignment="Center"
                                           Margin="18,0,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- EL DOBLEZ DEL ACERO DEL MURO, EN DIAMETROS.
                             Tus dos macros lo traen fijo en 15 (FACTOR_DOBLES_MURO), y es el
                             MISMO criterio que el gancho de arranque del dado en las aisladas.
                             Por eso se lee de la MISMA casilla: media obra a 15 diametros y la
                             otra media a 40 no es un plano, es un error de armado. -->
                        <Border Style="{StaticResource TarjetaStyle}"
                                Padding="12,9" Margin="0,0,0,8"
                                HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Doblez del acero del muro:" FontWeight="SemiBold" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,10,0"
                                           Foreground="{DynamicResource BrandDarkBrush}" />

                                <TextBox x:Name="ZapCorGanchoBox" Width="60" Text="15"
                                         VerticalAlignment="Center" VerticalContentAlignment="Center"
                                         TextAlignment="Center" FontSize="12" Padding="4,3"
                                         TextChanged="OnGanchoCorridaCambio"
                                         ToolTip="Largo del doblez del acero del muro, en diametros de la varilla.&#10;Tus macros usan 15. Es el MISMO valor que la hoja de zapatas aisladas: se cambia aqui o alla, y las dos hojas quedan iguales." />

                                <TextBlock Text="diametros" FontSize="12" VerticalAlignment="Center"
                                           Margin="8,0,0,0" />

                                <TextBlock x:Name="ZapCorGanchoText" FontSize="11" Opacity="0.8"
                                           VerticalAlignment="Center" Margin="18,0,0,0" />
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
                            <Button Content="Revisar zapatas corridas"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="OnRevisarZapatasCorridas"
                                    ToolTip="Comprueba las filas y dice donde se va a dibujar cada zapata corrida." />

                            <Button x:Name="DibujarZapatasCorridasButton"
                                    Content="Dibujar zapatas corridas en AutoCAD"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="OnExportZapatasCorridas"
                                    Margin="8,0,0,0"
                                    ToolTip="Dibuja cada zapata corrida en el AutoCAD que ya tengas abierto, en las posiciones de tus macros.&#10;La contratrabe y la cadena de desplante se insertan como bloque buscandolas por su ID." />
                        </StackPanel>
                    </StackPanel>

                    <DataGrid x:Name="ZapatasCorridasGrid" Grid.Row="1"
                              Style="{StaticResource SheetGridStyle}"
                              SelectionUnit="FullRow"
                              FrozenColumnCount="2"
                              HeadersVisibility="All"
                              ColumnHeaderStyle="{StaticResource EncabezadoHojaStyle}">
                        <DataGrid.Columns>
                            <!-- Identificacion. El TIPO va con el patron de esta hoja:
                                 plantilla con ComboBox EDITABLE enlazado por Text y la lista
                                 puesta desde la propia clase con x:Static. Con
                                 SelectedItemBinding y la lista llegando desde el code-behind,
                                 el enlace PISA el valor capturado. -->
                            <DataGridTemplateColumn Header="Tipo" Width="95"
                                                    CellStyle="{StaticResource CeldaIdent}"
                                                    SortMemberPath="Tipo">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Tipo}"
                                                   Style="{StaticResource ComboCeldaLectura}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox IsEditable="True" IsDropDownOpen="True"
                                                  BorderThickness="0" Padding="2,0"
                                                  VerticalContentAlignment="Center"
                                                  ItemsSource="{Binding Source={x:Static models:ZapataCorridaRow.Tipos}}"
                                                  Text="{Binding Tipo, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="CENTRAL: el muro va centrado y las secciones crecen a la derecha.&#10;LINDERO: el muro va pegado al paño derecho y crecen a la izquierda." />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id, UpdateSourceTrigger=PropertyChanged}"
                                                Width="70" CellStyle="{StaticResource CeldaIdent}" />

                            <!-- Geometria de la zapata, EN METROS como en la macro -->
                            <DataGridTextColumn Header="Ancho m" Binding="{Binding AnchoM, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}"
                                                Width="75" CellStyle="{StaticResource CeldaGeom}" />
                            <DataGridTextColumn Header="Prof. m" Binding="{Binding ProfundidadM, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}"
                                                Width="75" CellStyle="{StaticResource CeldaGeom}" />
                            <DataGridTextColumn Header="Espesor m" Binding="{Binding EspesorM, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}"
                                                Width="80" CellStyle="{StaticResource CeldaGeom}" />

                            <!-- Parrillas de la zapata -->
                            <DataGridTemplateColumn Header="Doble parrilla" Width="95"
                                                    CellStyle="{StaticResource CeldaEstribo}"
                                                    SortMemberPath="DobleParrilla">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DobleParrilla}"
                                                   Style="{StaticResource ComboCeldaLectura}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox IsEditable="True" IsDropDownOpen="True"
                                                  BorderThickness="0" Padding="2,0"
                                                  VerticalContentAlignment="Center"
                                                  ItemsSource="{Binding Source={x:Static models:ZapataCorridaRow.SiNo}}"
                                                  Text="{Binding DobleParrilla, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="SI: dos parrillas. NO: una sola, la inferior." />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <!-- LA PARRILLA INFERIOR: UNA SOLA COLUMNA CON SUS CUATRO CASILLAS.
                                 Es una columna de PLANTILLA y no cuatro columnas porque asi el
                                 titulo «PARRILLA INFERIOR» abarca de verdad las cuatro: WPF no
                                 tiene cabeceras combinadas, y con cuatro columnas cada cabecera
                                 se recorta a la suya y del titulo solo se leian trozos.

                                 La cabecera lleva dos renglones -la banda y los cuatro nombres- y
                                 la celda las cuatro casillas: dos listas de numero de varilla y
                                 dos de separacion en cm. Todo eso esta en Theme/ExcelTabs.xaml,
                                 en CabeceraParrillaInferior y CeldasParrillaInferior, y lo usan
                                 IGUAL las dos hojas de zapatas.

                                 Los 350 son 115 + 60 + 115 + 60, los anchos de las cuatro
                                 casillas de dentro.

                                 El nombre dice el LECHO y el TRABAJO de cada varilla, que es como
                                 salen rotuladas en el plano: en la parrilla de abajo la de flexion
                                 va en el lecho inferior y la de temperatura se apoya encima. -->
                            <DataGridTemplateColumn Header="PARRILLA INFERIOR" Width="350"
                                                    HeaderStyle="{StaticResource CabeceraParrillaStyle}"
                                                    HeaderTemplate="{StaticResource CabeceraParrillaInferior}"
                                                    CellTemplate="{StaticResource CeldasParrillaInferior}"
                                                    CellStyle="{StaticResource CeldaParrillaInf}"
                                                    CanUserSort="False" />

                            <!-- Y LA PARRILLA SUPERIOR, apagada cuando no la hay: eso lo hace el
                                 CellStyle, que mira EsDobleParrilla y al apagar la celda apaga
                                 sus cuatro casillas de dentro.

                                 Ahi las palabras del lecho van al REVES, porque la de flexion se
                                 amarra por el lomo y la de temperatura queda debajo. -->
                            <DataGridTemplateColumn Header="PARRILLA SUPERIOR" Width="350"
                                                    HeaderStyle="{StaticResource CabeceraParrillaStyle}"
                                                    HeaderTemplate="{StaticResource CabeceraParrillaSuperior}"
                                                    CellTemplate="{StaticResource CeldasParrillaSuperior}"
                                                    CellStyle="{StaticResource CeldaParrillaSup}"
                                                    CanUserSort="False" />
                            <!-- El muro. El espesor va en CENTIMETROS, como en la hoja:
                                 la macro lo divide entre 100 al dibujar. -->
                            <DataGridTemplateColumn Header="Muro" Width="130"
                                                    CellStyle="{StaticResource CeldaAcabado}"
                                                    SortMemberPath="TipoMuro">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TipoMuro}"
                                                   Style="{StaticResource ComboCeldaLectura}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox IsEditable="True" IsDropDownOpen="True"
                                                  BorderThickness="0" Padding="2,0"
                                                  VerticalContentAlignment="Center"
                                                  ItemsSource="{Binding Source={x:Static models:ZapataCorridaRow.TiposDeMuro}}"
                                                  Text="{Binding TipoMuro, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="MAMPOSTERIA: lleva muro de enrase de block y cadena de desplante.&#10;CONCRETO: lleva su acero vertical con doblez y sus varillas de punta." />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <!-- El ToolTip de una columna de texto va en su ElementStyle:
                                 una columna no es un control y ponerselo directo da el
                                 error de compilacion MC3072. -->
                            <DataGridTextColumn Header="e muro cm"
                                                Binding="{Binding EspesorMuroCm, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}"
                                                Width="85" CellStyle="{StaticResource CeldaAcabado}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="ToolTip"
                                                Value="Espesor del muro en CENTIMETROS. En blanco o 0, la macro usa 15." />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="Muro doble parr." Width="110"
                                                    CellStyle="{StaticResource CeldaSoloConcreto}"
                                                    SortMemberPath="MuroDobleParrilla">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding MuroDobleParrilla}"
                                                   Style="{StaticResource ComboCeldaLectura}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox IsEditable="True" IsDropDownOpen="True"
                                                  BorderThickness="0" Padding="2,0"
                                                  VerticalContentAlignment="Center"
                                                  ItemsSource="{Binding Source={x:Static models:ZapataCorridaRow.SiNo}}"
                                                  Text="{Binding MuroDobleParrilla, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="Solo para muro de CONCRETO: acero en los dos paños, a 5 cm de cada uno.&#10;Si el muro es tan delgado que no caben los dos, la macro lo pone al centro." />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <!-- LAS DOS VARILLAS DEL MURO. En la hoja de las macros hay UNA sola
                                 casilla y las dos direcciones la comparten; se pidio poder elegir
                                 las dos. Si la vertical se deja vacia se usa la horizontal, asi que
                                 una hoja vieja dibuja igual. -->
                            <DataGridComboBoxColumn x:Name="ColZapCorVarMuro" Header="Var muro horiz."
                                                    SelectedItemBinding="{Binding VarMuro, UpdateSourceTrigger=PropertyChanged}" Width="110"
                                                    ElementStyle="{StaticResource ComboCeldaMuestra}" EditingElementStyle="{StaticResource ComboCeldaEdicion}"
                                                    CellStyle="{StaticResource CeldaSoloConcreto}" />
                            <DataGridComboBoxColumn x:Name="ColZapCorVarMuroVert" Header="Var muro vert."
                                                    SelectedItemBinding="{Binding VarMuroVert, UpdateSourceTrigger=PropertyChanged}" Width="110"
                                                    ElementStyle="{StaticResource ComboCeldaMuestra}" EditingElementStyle="{StaticResource ComboCeldaEdicion}"
                                                    CellStyle="{StaticResource CeldaSoloConcreto}" />
                            <DataGridTextColumn Header="@ horiz cm" Binding="{Binding SepMuroHoriz, UpdateSourceTrigger=PropertyChanged}"
                                                Width="90" CellStyle="{StaticResource CeldaSoloConcreto}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="ToolTip"
                                                Value="Separacion HORIZONTAL. En el corte no se ve: solo entra en el rotulo.&#10;Solo con muro de concreto: con mamposteria la casilla se apaga." />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="@ vert cm" Binding="{Binding SepMuroVert, UpdateSourceTrigger=PropertyChanged}"
                                                Width="90" CellStyle="{StaticResource CeldaSoloConcreto}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="ToolTip"
                                                Value="Separacion VERTICAL: es la que reparte hacia arriba las varillas que salen de punta.&#10;Solo con muro de concreto: con mamposteria la casilla se apaga." />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Contratrabe y cadena: se INSERTAN COMO BLOQUE buscandolas
                                 por su ID, asi que la lista ofrece las que ya estan
                                 capturadas en la hoja de concreto. La celda sigue siendo
                                 editable: el bloque puede estar en el dibujo sin estar
                                 capturado, y eso es corriente en un plano empezado. -->
                            <DataGridTemplateColumn Header="Contratrabe" Width="115"
                                                    CellStyle="{StaticResource CeldaIdent}"
                                                    SortMemberPath="IdContratrabe">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding IdContratrabe}"
                                                   Style="{StaticResource ComboCeldaLectura}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox IsEditable="True" IsDropDownOpen="True"
                                                  BorderThickness="0" Padding="2,0"
                                                  VerticalContentAlignment="Center"
                                                  ItemsSource="{Binding Source={x:Static models:ZapataCorridaRow.ContratrabesDisponibles}}"
                                                  Text="{Binding IdContratrabe, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="ID del bloque de la contratrabe. Vacio = la zapata no lleva.&#10;Se apoya en el pano de arriba de la plantilla, como en tus macros: arranca del desplante y atraviesa el espesor.&#10;Su caja manda en el hatch de la zapata, en el hueco de su linea superior y en el tope del muro de enrase." />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Cadena despl." Width="115"
                                                    CellStyle="{StaticResource CeldaSoloMamposteria}"
                                                    SortMemberPath="IdCadena">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding IdCadena}"
                                                   Style="{StaticResource ComboCeldaLectura}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox IsEditable="True" IsDropDownOpen="True"
                                                  BorderThickness="0" Padding="2,0"
                                                  VerticalContentAlignment="Center"
                                                  ItemsSource="{Binding Source={x:Static models:ZapataCorridaRow.CadenasDisponibles}}"
                                                  Text="{Binding IdCadena, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="ID del bloque de la cadena de desplante. Solo con muro de mamposteria: con concreto la casilla se apaga.&#10;Su fondo es el tope del muro de enrase y su ancho es el que se enrasa." />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="f'c" Binding="{Binding Fc, UpdateSourceTrigger=PropertyChanged}"
                                                Width="70" CellStyle="{StaticResource CeldaAcabado}" />

                            <DataGridTextColumn Header="Falta" Binding="{Binding Falta}"
                                                Width="220" IsReadOnly="True"
                                                CellStyle="{StaticResource CeldaCalculada}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Style="{StaticResource MarcoPreviaStyle}" Grid.Row="2"
                            >
                        <Grid>
                            <Canvas x:Name="ZapataCorridaPreviewCanvas"
                                    Background="{StaticResource PreviewFondoBrush}"
                                    ClipToBounds="True" />
                            <TextBlock Text="Vista previa de la zapata corrida seleccionada"
                                       FontSize="10.5" Margin="8,6,0,0"
                                       VerticalAlignment="Top" HorizontalAlignment="Left"
                                       Foreground="{DynamicResource BrandDarkBrush}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource BarraTotalesStyle}" Grid.Row="3"
                            >
                        <TextBlock x:Name="TotalesZapatasCorridasText" Style="{StaticResource TextoTotalesStyle}" />
                    </Border>
                </Grid>
            </TabItem>

            <!-- ===== Zapatas aisladas ===== -->
            <TabItem Header="Zapatas Aisladas">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="300" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Zapatas aisladas" Style="{StaticResource ModuleTitleStyle}"
                                   ToolTip="Las columnas son las celdas de tus dos macros. La de TIPO decide todo lo que cambia entre ellas: la CENTRAL lleva el dado centrado y las secciones crecen a la derecha; la de LINDERO lleva el dado pegado al paño derecho -ese es el lindero- y crecen a la izquierda." />

                        <!-- Los dos botones de la hoja.

                             «Revisar» funciona: comprueba las filas y dice, zapata por
                             zapata, en que x se va a dibujar y donde cae su planta.

                             «Dibujar en AutoCAD» va DESHABILITADO a proposito, y su globo
                             dice por que: el dibujante de zapatas es lo siguiente. Un boton
                             que se puede pulsar y no dibuja es peor que un boton apagado
                             que dice lo que falta. -->
                        <!-- EL TIPO DE SECCION VA ARRIBA Y AFECTA A TODAS LAS ZAPATAS.
                             Son los MISMOS botones de la hoja de concreto: estan atados a ellos
                             con un enlace por ElementName, asi que el tipo de seccion es UNA
                             decision para el juego entero y no puede quedar la mitad del plano
                             relleno y la otra mitad no. Por eso no va como columna de la tabla. -->
                        <Border Style="{StaticResource TarjetaStyle}"
                                Padding="12,9" Margin="0,0,0,8"
                                HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Estilo de dibujo:" FontWeight="SemiBold" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,14,0"
                                           Foreground="{DynamicResource BrandDarkBrush}" />

                                <RadioButton x:Name="ZapTipo1Radio" GroupName="TipoSeccionZapata"
                                             VerticalAlignment="Center" Margin="0,0,22,0"
                                             IsChecked="{Binding IsChecked, ElementName=Tipo1Radio, Mode=TwoWay}">
                                    <TextBlock Text="Seccion tipo 1 - no rellena" FontWeight="SemiBold" FontSize="12" />
                                </RadioButton>

                                <RadioButton x:Name="ZapTipo2Radio" GroupName="TipoSeccionZapata"
                                             VerticalAlignment="Center"
                                             IsChecked="{Binding IsChecked, ElementName=Tipo2Radio, Mode=TwoWay}">
                                    <TextBlock Text="Seccion tipo 2 - rellena" FontWeight="SemiBold" FontSize="12" />
                                </RadioButton>

                                <TextBlock Text="Es el mismo estilo de las secciones de concreto: vale para todo el juego."
                                           FontSize="11" Opacity="0.75" VerticalAlignment="Center"
                                           Margin="18,0,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- EL DOBLEZ DEL GANCHO DE ARRANQUE, EN DIAMETROS, PARA TODAS LAS ZAPATAS.
                             La macro lo trae fijo en 15 diametros; aqui se puede cambiar -40, o los
                             que haga falta- y con ese valor salen el dibujo Y SUS COTAS.

                             Va arriba y no como columna de la tabla por lo mismo que el estilo de
                             seccion: es una decision del juego entero. Media pata a 15 diametros y
                             la otra media a 40 no es un plano, es un error de armado. -->
                        <Border Style="{StaticResource TarjetaStyle}"
                                Padding="12,9" Margin="0,0,0,8"
                                HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Doblez del gancho de arranque:" FontWeight="SemiBold" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,10,0"
                                           Foreground="{DynamicResource BrandDarkBrush}" />

                                <TextBox x:Name="ZapGanchoDiametrosBox" Width="60" Text="15"
                                         VerticalAlignment="Center" VerticalContentAlignment="Center"
                                         TextAlignment="Center" FontSize="12" Padding="4,3"
                                         TextChanged="OnGanchoZapataCambio"
                                         ToolTip="Largo de la pata del gancho de arranque del dado, en diametros de la varilla.&#10;La macro usa 15. Con 40, una varilla del #4 pasa de 19 a 51 cm.&#10;Vale para TODAS las zapatas, y las cotas salen con este mismo valor." />

                                <TextBlock Text="diametros" FontSize="12" VerticalAlignment="Center"
                                           Margin="8,0,0,0" />

                                <TextBlock x:Name="ZapGanchoHintText" FontSize="11" Opacity="0.75"
                                           VerticalAlignment="Center" Margin="18,0,0,0" />
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
                            <!-- LOS MISMOS ESTILOS QUE LAS SECCIONES DE CONCRETO Y DE ACERO:
                                 SecondaryButtonStyle para revisar y PrimaryButtonStyle -con su
                                 color de marca- para dibujar. Antes llevaban los estilos planos
                                 de la barra de herramientas, sin fondo, y el boton de dibujar de
                                 esta pestana no se veia como el de las otras dos aunque haga
                                 exactamente lo mismo. -->
                            <Button Content="Revisar zapatas"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="OnRevisarZapatas"
                                    ToolTip="Comprueba las filas y dice donde se va a dibujar cada zapata." />

                            <Button x:Name="DibujarZapatasButton"
                                    Content="Dibujar zapatas en AutoCAD"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="OnExportZapatas"
                                    Margin="8,0,0,0"
                                    ToolTip="Dibuja cada zapata en el AutoCAD que ya tengas abierto: su corte y su planta, en las posiciones de tus macros.&#10;Revisa primero y no dibuja si falta algo. El dado se inserta como bloque buscandolo por su ID." />
                        </StackPanel>
                    </StackPanel>

                    <DataGrid x:Name="ZapatasGrid" Grid.Row="1"
                              Style="{StaticResource SheetGridStyle}"
                              SelectionUnit="FullRow"
                              FrozenColumnCount="2"
                              HeadersVisibility="All"
                              ColumnHeaderStyle="{StaticResource EncabezadoHojaStyle}">
                        <DataGrid.Columns>
                            <!-- Identificacion -->
                            <!-- EL TIPO va con el patron de la hoja de concreto: plantilla
                                 con un ComboBox EDITABLE enlazado por Text, y la lista
                                 puesta en el XAML desde la propia clase.

                                 Con SelectedItemBinding y la lista llenada desde el
                                 code-behind pasaba esto: si la columna recibe su
                                 ItemsSource cuando las filas ya estan enlazadas, la celda
                                 no encuentra su valor en la lista y el enlace lo PISA. Las
                                 dos zapatas del ejemplo salian «de lindero» aunque una
                                 estaba capturada como central. -->
                            <DataGridTemplateColumn Header="Tipo" Width="95"
                                                    CellStyle="{StaticResource CeldaIdent}"
                                                    SortMemberPath="Tipo">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Tipo}"
                                                   Style="{StaticResource ComboCeldaLectura}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox IsEditable="True" IsDropDownOpen="True"
                                                  BorderThickness="0" Padding="2,0"
                                                  VerticalContentAlignment="Center"
                                                  ItemsSource="{Binding Source={x:Static models:ZapataAisladaRow.Tipos}}"
                                                  Text="{Binding Tipo, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="CENTRAL: el dado va centrado y las secciones crecen a la derecha.&#10;LINDERO: el dado va pegado al paño derecho y crecen a la izquierda." />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id, UpdateSourceTrigger=PropertyChanged}"
                                                Width="70" CellStyle="{StaticResource CeldaIdent}" />

                            <!-- Geometria de la zapata, EN METROS como en la macro -->
                            <DataGridTextColumn Header="Ancho m" Binding="{Binding AnchoM, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}"
                                                Width="75" CellStyle="{StaticResource CeldaGeom}" />
                            <DataGridTextColumn Header="Largo m" Binding="{Binding LargoM, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}"
                                                Width="75" CellStyle="{StaticResource CeldaGeom}" />
                            <DataGridTextColumn Header="Prof. m" Binding="{Binding ProfundidadM, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}"
                                                Width="75" CellStyle="{StaticResource CeldaGeom}" />
                            <DataGridTextColumn Header="Espesor m" Binding="{Binding EspesorM, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}"
                                                Width="80" CellStyle="{StaticResource CeldaGeom}" />

                            <!-- Parrilla inferior -->
                            <!-- DOBLE PARRILLA Y RELLENO: dos casillas de SI o NO.
                                 Van con lista porque escribirlas a mano se presta a que un «SÍ»
                                 con acento o una «S» dejen la zapata con una sola parrilla sin
                                 que nada lo diga: la celda se lee buscando «SI» al principio.
                                 El combo va EDITABLE y enlazado por Text, como el resto de esta
                                 hoja, para que lo teclado tambien llegue a la propiedad. -->
                            <DataGridTemplateColumn Header="Doble parrilla" Width="95"
                                                    CellStyle="{StaticResource CeldaEstribo}"
                                                    SortMemberPath="DobleParrilla">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DobleParrilla}"
                                                   Style="{StaticResource ComboCeldaLectura}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox IsEditable="True" IsDropDownOpen="True"
                                                  BorderThickness="0" Padding="2,0"
                                                  VerticalContentAlignment="Center"
                                                  ItemsSource="{Binding Source={x:Static models:ZapataAisladaRow.SiNo}}"
                                                  Text="{Binding DobleParrilla, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="SI: dos parrillas, con su linea de rotura en la planta.&#10;NO: una sola parrilla, la inferior." />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <!-- LA PARRILLA INFERIOR: UNA SOLA COLUMNA CON SUS CUATRO CASILLAS.
                                 Es una columna de PLANTILLA y no cuatro columnas porque asi el
                                 titulo «PARRILLA INFERIOR» abarca de verdad las cuatro: WPF no
                                 tiene cabeceras combinadas, y con cuatro columnas cada cabecera
                                 se recorta a la suya y del titulo solo se leian trozos.

                                 La cabecera lleva dos renglones -la banda y los cuatro nombres- y
                                 la celda las cuatro casillas: dos listas de numero de varilla y
                                 dos de separacion en cm. Todo eso esta en Theme/ExcelTabs.xaml,
                                 en CabeceraParrillaInferior y CeldasParrillaInferior, y lo usan
                                 IGUAL las dos hojas de zapatas.

                                 Los 350 son 115 + 60 + 115 + 60, los anchos de las cuatro
                                 casillas de dentro.

                                 El nombre dice el LECHO y el TRABAJO de cada varilla, que es como
                                 salen rotuladas en el plano: en la parrilla de abajo la de flexion
                                 va en el lecho inferior y la de temperatura se apoya encima. -->
                            <DataGridTemplateColumn Header="PARRILLA INFERIOR" Width="350"
                                                    HeaderStyle="{StaticResource CabeceraParrillaStyle}"
                                                    HeaderTemplate="{StaticResource CabeceraParrillaInferior}"
                                                    CellTemplate="{StaticResource CeldasParrillaInferior}"
                                                    CellStyle="{StaticResource CeldaParrillaInf}"
                                                    CanUserSort="False" />

                            <!-- Y LA PARRILLA SUPERIOR, apagada cuando no la hay: eso lo hace el
                                 CellStyle, que mira EsDobleParrilla y al apagar la celda apaga
                                 sus cuatro casillas de dentro.

                                 Ahi las palabras del lecho van al REVES, porque la de flexion se
                                 amarra por el lomo y la de temperatura queda debajo. -->
                            <DataGridTemplateColumn Header="PARRILLA SUPERIOR" Width="350"
                                                    HeaderStyle="{StaticResource CabeceraParrillaStyle}"
                                                    HeaderTemplate="{StaticResource CabeceraParrillaSuperior}"
                                                    CellTemplate="{StaticResource CeldasParrillaSuperior}"
                                                    CellStyle="{StaticResource CeldaParrillaSup}"
                                                    CanUserSort="False" />
                            <!-- Dado y columna. El ancho va en CENTIMETROS, como en la
                                 macro: ahi se multiplican por SCALEELEVATION al dibujar. -->
                            <DataGridTemplateColumn Header="Desplanta" Width="155"
                                                    CellStyle="{StaticResource CeldaAcabado}"
                                                    SortMemberPath="TipoColumna">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TipoColumna}"
                                                   Style="{StaticResource ComboCeldaLectura}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox IsEditable="True" IsDropDownOpen="True"
                                                  BorderThickness="0" Padding="2,0"
                                                  VerticalContentAlignment="Center"
                                                  ItemsSource="{Binding Source={x:Static models:ZapataAisladaRow.TiposColumna}}"
                                                  Text="{Binding TipoColumna, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="De concreto: se dibuja la columna encima del dado y los ganchos de arranque doblan hacia adentro.&#10;De acero: no hay columna de concreto, y los ganchos doblan hacia afuera." />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <!-- EL DADO SE ELIGE DE LA HOJA DE CONCRETO.
                                 El dado no es un dato suelto: es una seccion de concreto
                                 con su armado y su forma, y la macro la inserta en la
                                 zapata como BLOQUE, buscandola por su ID. La lista se
                                 llena sola con los dados capturados -DADO y DADO
                                 CIRCULAR- y se actualiza al agregar o borrar uno, porque
                                 la coleccion es observable.

                                 Sigue siendo editable: se puede escribir un ID que
                                 todavia no este capturado, porque el orden en que se
                                 llenan las hojas es del usuario. -->
                            <DataGridTemplateColumn Header="ID dado" Width="90"
                                                    CellStyle="{StaticResource CeldaIdent}"
                                                    SortMemberPath="IdDado">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding IdDado}"
                                                   Style="{StaticResource ComboCeldaLectura}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox IsEditable="True" IsDropDownOpen="True"
                                                  BorderThickness="0" Padding="2,0"
                                                  VerticalContentAlignment="Center"
                                                  ItemsSource="{Binding Source={x:Static models:ZapataAisladaRow.DadosDisponibles}}"
                                                  Text="{Binding IdDado, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="Los dados capturados en «Secciones Concreto» (DADO y DADO CIRCULAR).&#10;La zapata inserta ese dado como bloque, buscandolo por su ID.&#10;Al elegirlo, «Dado cm» y «Rec. dado cm» se llenan solos con las medidas reales de esa seccion." />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <!-- SE LLENA SOLA con el ancho de la seccion del dado elegido, y se
                                 vuelve a poner al dia si esa seccion cambia. Sigue siendo
                                 editable para un caso a mano, pero lo escrito a mano no gana
                                 contra la seccion: la referencia es la seccion. -->
                            <DataGridTextColumn Header="Dado cm" Binding="{Binding AnchoDadoCm, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}"
                                                Width="75" CellStyle="{StaticResource CeldaLateral}">
                                <!-- El globo va en ElementStyle y NO como ToolTip de la
                                     columna: una columna de DataGrid no es un control, no
                                     tiene ToolTip, y ponerselo es el error MC3072. Lo que
                                     tiene globo es el TextBlock de la celda. -->
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="ToolTip"
                                                Value="Se llena sola con el ancho real del dado elegido en «ID dado»." />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <!-- LA COLUMNA SE ELIGE DE LAS DOS HOJAS.
                                 La lista trae las columnas capturadas en «Secciones
                                 Concreto» -COLUMNA y COLUMNA CIRCULAR- y las de «Secciones
                                 Acero» cuyo elemento es COLUMNA, marcadas con su hoja para
                                 poder distinguirlas. Se guarda solo el ID.

                                 Es para no teclearlo: escribirlo distinto -«C-1» y «C1»- es un
                                 error que no se ve mirando la tabla, y ademas al elegirla de la
                                 lista se traen SOLAS su medida, su recubrimiento y su tipo.

                                 REPETIR LA MISMA COLUMNA EN VARIAS ZAPATAS NO ES UN ERROR: lo
                                 que se captura en «Secciones» es el TIPO de columna, y el mismo
                                 tipo desplanta en todas las cimentaciones donde toque.
                                 «Revisar zapatas» lo cuenta, no lo reprocha. -->
                            <DataGridTemplateColumn Header="ID col." Width="95"
                                                    CellStyle="{StaticResource CeldaIdent}"
                                                    SortMemberPath="IdColumna">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding IdColumna}"
                                                   Style="{StaticResource ComboCeldaLectura}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox IsEditable="True" IsDropDownOpen="True"
                                                  BorderThickness="0" Padding="2,0"
                                                  VerticalContentAlignment="Center"
                                                  ItemsSource="{Binding Source={x:Static models:ZapataAisladaRow.ColumnasDisponibles}}"
                                                  Text="{Binding IdColumna, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="Las columnas capturadas en «Secciones Concreto» y en «Secciones Acero».&#10;Se guarda solo el ID; la hoja va entre parentesis para poder distinguirlas.&#10;Al elegirla, «Col. cm», el recubrimiento y el TIPO -concreto o acero- se llenan solos con los de esa seccion.&#10;La misma columna puede estar en varias zapatas: el ID es el TIPO de columna." />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Col. cm" Binding="{Binding AnchoColumnaCm, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}"
                                                Width="75" CellStyle="{StaticResource CeldaLateral}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="ToolTip"
                                                Value="Se llena sola con la medida real de la columna elegida en «ID col.»:&#10;la base de la seccion de concreto, o el peralte del perfil de acero." />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Rec. dado cm" Binding="{Binding RecDadoCm, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}"
                                                Width="95" CellStyle="{StaticResource CeldaLateral}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="ToolTip"
                                                Value="Se llena solo con el recubrimiento de la seccion del dado elegido." />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- ARRANQUE Y ESTRIBOS DEL DADO: OCULTOS.
                                 Ya no se capturan: salen de la seccion del dado elegido en «ID
                                 dado» -sus varillas de esquina, sus intermedias y su estribo-.
                                 Se quedan en el modelo, y se siguen guardando en el trabajo,
                                 pero no se muestran: una celda que se rellena sola y que se
                                 puede escribir encima es una invitacion a que el plano diga una
                                 cosa y la seccion otra. Para cambiarlas se cambia la seccion. -->
                            <!-- Arranque del dado -->
                            <DataGridComboBoxColumn x:Name="ColZapVarDadoSup" Header="Arranque 1"
                                                    SelectedItemBinding="{Binding VarDadoSup, UpdateSourceTrigger=PropertyChanged}" Width="85"
                                                    ElementStyle="{StaticResource ComboCeldaMuestra}" EditingElementStyle="{StaticResource ComboCeldaEdicion}"
                                                    CellStyle="{StaticResource CeldaLateral}" 
                                                Visibility="Collapsed"/>
                            <DataGridComboBoxColumn x:Name="ColZapVarDadoInf" Header="Arranque 2"
                                                    SelectedItemBinding="{Binding VarDadoInf, UpdateSourceTrigger=PropertyChanged}" Width="85"
                                                    ElementStyle="{StaticResource ComboCeldaMuestra}" EditingElementStyle="{StaticResource ComboCeldaEdicion}"
                                                    CellStyle="{StaticResource CeldaLateral}" 
                                                Visibility="Collapsed"/>
                            <DataGridTextColumn Header="N int." Binding="{Binding NIntDado, UpdateSourceTrigger=PropertyChanged}"
                                                Width="60" CellStyle="{StaticResource CeldaLateral}" 
                                                Visibility="Collapsed"/>
                            <DataGridComboBoxColumn x:Name="ColZapVarIntDado" Header="Var int."
                                                    SelectedItemBinding="{Binding VarIntDado, UpdateSourceTrigger=PropertyChanged}" Width="75"
                                                    ElementStyle="{StaticResource ComboCeldaMuestra}" EditingElementStyle="{StaticResource ComboCeldaEdicion}"
                                                    CellStyle="{StaticResource CeldaLateral}" 
                                                Visibility="Collapsed"/>
                            <DataGridComboBoxColumn x:Name="ColZapEstribo" Header="Estribo"
                                                    SelectedItemBinding="{Binding EstriboDado, UpdateSourceTrigger=PropertyChanged}" Width="75"
                                                    ElementStyle="{StaticResource ComboCeldaMuestra}" EditingElementStyle="{StaticResource ComboCeldaEdicion}"
                                                    CellStyle="{StaticResource CeldaEstribo}" 
                                                    Visibility="Collapsed"/>
                            <!-- LA SEPARACION DE ESTRIBOS SE PUEDE ESCRIBIR A MANO.
                                 La lista son sugerencias, no una lista cerrada: se puede
                                 teclear «6-12-6», «15» o lo que haga falta.

                                 Va con plantilla y ComboBox EDITABLE enlazado por Text, no
                                 con SelectedItemBinding, porque con SelectedItem lo que se
                                 teclea no llega a la propiedad y se pierde al salir de la
                                 celda. Es el mismo patron -y el mismo motivo- que la
                                 columna «Sep cm» de la hoja de concreto. -->
                            <DataGridTemplateColumn Header="Est. @ cm" Width="95"
                                                    CellStyle="{StaticResource CeldaEstribo}"
                                                    SortMemberPath="SepEstriboDado"
                                                    Visibility="Collapsed">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SepEstriboDado}"
                                                   Style="{StaticResource ComboCeldaLectura}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox IsEditable="True" IsDropDownOpen="True"
                                                  BorderThickness="0" Padding="2,0"
                                                  VerticalContentAlignment="Center"
                                                  ItemsSource="{Binding Source={x:Static models:SeccionConcretoRow.SeparacionesUsuales}}"
                                                  Text="{Binding SepEstriboDado, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="Elige una de la lista o escribe la que necesites, por ejemplo 9-18-9 o 15.&#10;Con tres tramos, el dado se reparte 25 % - 50 % - 25 %: confinamiento, centro y confinamiento." />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="f'c" Binding="{Binding Fc, UpdateSourceTrigger=PropertyChanged}"
                                                Width="60" CellStyle="{StaticResource CeldaAcabado}" />

                            <!-- Calculadas -->
                            <DataGridTextColumn Header="Falta" Binding="{Binding Falta}"
                                                IsReadOnly="True" Width="200"
                                                CellStyle="{StaticResource CeldaCalculada}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- ===== VISTA PREVIA: ELEVACION Y PLANTA =====

                         Las dos vistas juntas y a la MISMA escala, porque es como salen
                         en el plano: la planta cuelga de la vista de corte -a 3 m en la
                         central y a 15 abajo en el lindero-, y esa distancia es parte de
                         lo que hay que poder revisar antes de mandar el dibujo.

                         La geometria sale de TrazoZapata, que es la misma clase que va a
                         usar el dibujante de AutoCAD. -->
                    <Border Style="{StaticResource MarcoPreviaStyle}" Grid.Row="2"
                            >
                        <Grid>
                            <Canvas x:Name="ZapataPreviewCanvas"
                                    Background="{StaticResource PreviewFondoBrush}"
                                    ClipToBounds="True" />
                            <TextBlock Text="Vista previa de la zapata seleccionada"
                                       FontSize="10.5" Margin="8,6,0,0"
                                       VerticalAlignment="Top" HorizontalAlignment="Left"
                                       Foreground="{DynamicResource BrandDarkBrush}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource BarraTotalesStyle}" Grid.Row="3"
                            >
                        <TextBlock x:Name="TotalesZapatasText" Style="{StaticResource TextoTotalesStyle}" />
                    </Border>
                </Grid>
            </TabItem>

            <!-- ===== Muros de contencion ===== -->
            <TabItem Header="Muros de Contencion">
                <StackPanel Margin="22">
                    <TextBlock Text="Muros de contencion" Style="{StaticResource ModuleTitleStyle}"
                                   ToolTip="Seccion del muro, talon, punta y su armado." />
                    <Border Style="{StaticResource TarjetaStyle}"
                            Padding="16" MaxWidth="700" HorizontalAlignment="Left">
                        <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource TextBrush}"
                                   Text="Modulo pendiente de portar. Mandame la macro de esta hoja." />
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- ===== Placa base ===== -->
            <TabItem Header="Placa Base">
                <StackPanel Margin="22">
                    <TextBlock Text="Placas base" Style="{StaticResource ModuleTitleStyle}"
                                   ToolTip="Placa, anclas, atiesadores y su detalle de montaje." />
                    <Border Style="{StaticResource TarjetaStyle}"
                            Padding="16" MaxWidth="700" HorizontalAlignment="Left">
                        <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource TextBrush}"
                                   Text="Modulo pendiente de portar. Mandame la macro de esta hoja." />
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- ===== Conexiones ===== -->
            <TabItem Header="Conexiones">
                <StackPanel Margin="22">
                    <TextBlock Text="Conexiones" Style="{StaticResource ModuleTitleStyle}"
                                   ToolTip="Detalles de union: tornillos, soldadura, placas de cortante y momento." />
                    <Border Style="{StaticResource TarjetaStyle}"
                            Padding="16" MaxWidth="700" HorizontalAlignment="Left">
                        <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource TextBrush}"
                                   Text="Modulo pendiente de portar. Mandame la macro de esta hoja." />
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- ===== Dibujar planos estructurales ===== -->
            <TabItem x:Name="EtabsTab" Header="Dibujar planos estructurales">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="22">
                        <TextBlock Text="Dibujar planos estructurales" Style="{StaticResource ModuleTitleStyle}"
                                   ToolTip="La planta del modelo de ETABS, nivel por nivel. Es el punto de partida del plano estructural." />

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,10">
                            <!-- LA MISMA CASILLA DE LA PESTAÑA DE ETABS, aqui tambien.
                                 No es otra opcion aparte: las dos casillas son LA MISMA,
                                 atadas con un enlace de dos vias, asi que se cambie en la
                                 pestaña que sea, el programa elegido es uno solo y los
                                 botones de las dos pestañas le hablan al mismo. -->
                            <TextBlock Text="Programa:" FontWeight="SemiBold" FontSize="11.5"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox x:Name="ProgramaCsiPlanosCombo" Width="120"
                                      VerticalAlignment="Center" Margin="0,0,12,0"
                                      SelectedIndex="{Binding SelectedIndex, ElementName=ProgramaCsiCombo, Mode=TwoWay}"
                                      ToolTip="De donde se leen las plantas: de ETABS o de SAP2000.&#10;Es la misma casilla de la pestaña ETABS/SAP2000.">
                                <ComboBoxItem Content="ETABS" />
                                <ComboBoxItem Content="SAP2000" />
                            </ComboBox>

                            <Button x:Name="LeerPlantasButton" Content="Leer plantas de ETABS"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="OnLeerPlantas"
                                    ToolTip="Lee el modelo del programa de la casilla y arma la lista de niveles con sus plantas." />

                            <!-- El boton de dibujar vive junto a la planta que dibuja:
                                 lo que se manda a AutoCAD es EXACTAMENTE el nivel y los
                                 filtros que se estan viendo aqui abajo. -->
                            <!-- El modelo COMPLETO en 3D, cada barra con su perfil real
                                 extruido. Va aqui, al lado del de la planta, porque los
                                 dos salen del mismo modelo leido. -->
                            <Button x:Name="Modelo3dButton" Content="Dibujar en 3D"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="OnDibujar3dCad"
                                    ToolTip="Dibuja todo el modelo en 3D en AutoCAD, cada barra con su perfil real como sólido." />

                            <Button x:Name="PlantaCadButton" Content="Dibujar en AutoCAD"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="OnDibujarPlantaCad"
                                    ToolTip="Dibuja en AutoCAD TODAS las plantas de un jalon, una al lado de otra, como la macro.&#10;Requiere AutoCAD abierto." />

                            <!-- De un jalon TODAS, que es como se usa. La casilla es para
                                 cuando se quiere revisar una sola. -->
                            <CheckBox x:Name="SoloNivelElegidoChk" Content="Solo el nivel elegido"
                                      VerticalAlignment="Center" Margin="4,0,0,0"
                                      ToolTip="Apagada: se dibujan TODAS las plantas, repartidas a la derecha con la separacion de la hoja CONFIG.&#10;Encendida: solo la del nivel de abajo." />

                            <TextBlock x:Name="PlantasResumenText" FontSize="11.5" VerticalAlignment="Center"
                                       Margin="14,0,0,0" Foreground="{DynamicResource MutedTextBrush}" />
                        </StackPanel>

                        <!-- Los mismos filtros por tipo de elemento que el visor 3D -->
                        <Border Style="{StaticResource TarjetaStyle}"
                                Padding="12,8" Margin="0,0,0,10"
                                HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Mostrar:" FontWeight="SemiBold" FontSize="11.5"
                                           VerticalAlignment="Center" Margin="0,0,12,0" />
                                <CheckBox x:Name="VerColumnasPlanoChk" Content="Columnas" IsChecked="True"
                                          VerticalAlignment="Center" Margin="0,0,12,0" Click="OnFiltroPlanoCambiado" />
                                <CheckBox x:Name="VerTrabesPlanoChk" Content="Trabes" IsChecked="True"
                                          VerticalAlignment="Center" Margin="0,0,12,0" Click="OnFiltroPlanoCambiado" />
                                <CheckBox x:Name="VerMurosPlanoChk" Content="Muros" IsChecked="True"
                                          VerticalAlignment="Center" Margin="0,0,12,0" Click="OnFiltroPlanoCambiado" />
                                <CheckBox x:Name="VerLosasPlanoChk" Content="Losas" IsChecked="True"
                                          VerticalAlignment="Center" Margin="0,0,12,0" Click="OnFiltroPlanoCambiado" />
                                <CheckBox x:Name="VerEjesPlanoChk" Content="Ejes" IsChecked="True"
                                          VerticalAlignment="Center" Click="OnFiltroPlanoCambiado" />

                                <!-- EL CORTE SE ELIGE TAMBIEN AQUI, que es donde se manda a
                                     dibujar: tener que ir a la otra pestaña para escoger el
                                     eje y volver a esta para dibujarlo es un viaje que no
                                     hace falta. Las dos listas van sincronizadas. -->
                                <TextBlock Text="Corte por el eje:" FontSize="11.5" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="18,0,6,0" />
                                <ComboBox x:Name="CortePlanoCombo" Width="150"
                                          VerticalAlignment="Center"
                                          SelectionChanged="OnCorteEjeCambiado" />
                            </StackPanel>
                        </Border>

<!-- ==========================================================
                             EL VISUALIZADOR, EN DOS COLUMNAS
                             ==========================================================
                             Se pidio asi: a la IZQUIERDA la planta y sus cortes, a la
                             DERECHA el 3D. Y tiene sentido de uso: se elige el nivel y el
                             corte a la izquierda y se comprueba en el 3D de la derecha sin
                             cambiar de pestaña ni perder de vista lo uno ni lo otro.

                             Las dos columnas al 50%: las dos vistas son igual de
                             importantes, y con una mas ancha que la otra la estrecha deja
                             de servir para mirar. -->
                        <!-- ==========================================================
                             EL VISUALIZADOR: LAS DOS VISTAS, A LA MISMA ALTURA
                             ==========================================================
                             A la IZQUIERDA la planta y sus cortes, a la DERECHA el 3D, y
                             las dos AL MISMO NIVEL. Antes cada columna era un StackPanel
                             suelto, asi que cada lienzo empezaba donde acabara lo que
                             tuviera encima: la derecha llevaba una barra mas -la de las
                             vistas, dentro de su pestaña- y el modelo salia medio
                             renglon mas abajo que la planta.

                             Ahora es UNA rejilla de tres filas: titulo, barra y lienzo.
                             La altura de cada fila es la del cel mas alto de las dos
                             columnas, asi que los dos lienzos arrancan EXACTAMENTE en la
                             misma linea, pase lo que pase con las barras.

                             Y la barra de las vistas es UNA, fuera de las pestañas: era
                             la misma en las dos -Isometrica, Frente, Lado, Planta- asi
                             que tenerla duplicada dentro de cada una solo servia para
                             bajar el lienzo y para que las dos pudieran quedar
                             descuadradas. -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- IZQUIERDA: titulo, barra del nivel y la planta -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Vista en planta y cortes"
                                       FontWeight="SemiBold" FontSize="12.5" Margin="0,0,8,6"
                                       VerticalAlignment="Bottom"
                                       Foreground="{DynamicResource BrandDarkBrush}" />

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,8"
                                        VerticalAlignment="Bottom">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Nivel:" FontWeight="SemiBold" FontSize="11.5"
                                VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox x:Name="NivelPlantaCombo" Width="190"
                                VerticalAlignment="Center"
                                SelectionChanged="OnNivelPlantaCambiado" />
                                <TextBlock Text="Rueda para zoom. Boton derecho para mover."
                                FontSize="10.5" Foreground="{DynamicResource MutedTextBrush}"
                                VerticalAlignment="Center" Margin="14,0,0,0" />
                                </StackPanel>
                            </StackPanel>

                            <ContentControl Grid.Row="2" Grid.Column="0" Margin="0,0,8,0">
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="3" Background="{DynamicResource SurfaceBrush}">
                                <!-- Arrastrar con el boton IZQUIERDO o con el
                                DERECHO mueve la planta; la rueda hace zoom.
                                El izquierdo hace falta: es el que se usa por
                                instinto, y sin el parecia que la vista
                                estuviera clavada. -->
                                <Canvas x:Name="PlantaCanvas" Height="430" ClipToBounds="True"
                                Background="{DynamicResource SurfaceBrush}"
                                MouseLeftButtonDown="OnVistaMouseDown"
                                MouseRightButtonDown="OnVistaMouseDown"
                                MouseMove="OnVistaMouseMove"
                                MouseLeftButtonUp="OnVistaMouseUp"
                                MouseRightButtonUp="OnVistaMouseUp"
                                MouseLeave="OnVistaMouseUp"
                                MouseWheel="OnVistaWheel" />
                                </Border>
                            </ContentControl>

                            <!-- DERECHA: titulo, filtros y barra de vistas, y el modelo -->
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Vista del modelo"
                                       FontWeight="SemiBold" FontSize="12.5" Margin="8,0,0,6"
                                       VerticalAlignment="Bottom"
                                       Foreground="{DynamicResource BrandDarkBrush}" />

                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,8"
                                        VerticalAlignment="Bottom">
                                <!-- Filtros por tipo de elemento, comunes a las dos vistas -->
                                <Border Style="{StaticResource TarjetaStyle}"
                                Padding="12,8" Margin="0,0,0,8"
                                HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Mostrar:" FontWeight="SemiBold" FontSize="11.5"
                                VerticalAlignment="Center" Margin="0,0,12,0" />
                                <CheckBox x:Name="VerColumnasChk" Content="Columnas" IsChecked="True"
                                VerticalAlignment="Center" Margin="0,0,12,0" Click="OnFiltroVistaCambiado" />
                                <CheckBox x:Name="VerTrabesChk" Content="Trabes" IsChecked="True"
                                VerticalAlignment="Center" Margin="0,0,12,0" Click="OnFiltroVistaCambiado" />
                                <CheckBox x:Name="VerDiagonalesChk" Content="Diagonales" IsChecked="True"
                                VerticalAlignment="Center" Margin="0,0,12,0" Click="OnFiltroVistaCambiado" />
                                <CheckBox x:Name="VerMurosChk" Content="Muros" IsChecked="True"
                                VerticalAlignment="Center" Margin="0,0,12,0" Click="OnFiltroVistaCambiado" />
                                <CheckBox x:Name="VerLosasChk" Content="Losas" IsChecked="True"
                                VerticalAlignment="Center" Click="OnFiltroVistaCambiado" />
                                </StackPanel>
                                </Border>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="Isometrica" Style="{StaticResource SecondaryButtonStyle}"
                                Tag="ISO" Click="OnVistaPreset" />
                                <Button Content="Frente (XZ)" Style="{StaticResource SecondaryButtonStyle}"
                                Tag="FRENTE" Click="OnVistaPreset" />
                                <Button Content="Lado (YZ)" Style="{StaticResource SecondaryButtonStyle}"
                                Tag="LADO" Click="OnVistaPreset" />
                                <Button Content="Planta (XY)" Style="{StaticResource SecondaryButtonStyle}"
                                Tag="PLANTA" Click="OnVistaPreset" />

                                <!-- Encuadrar deja el zoom y el desplazamiento como
                                al principio SIN tocar el giro: es la salida
                                cuando uno se pierde arrastrando. -->
                                <Button Content="Encuadrar" Style="{StaticResource SecondaryButtonStyle}"
                                Tag="ENCUADRAR" Click="OnVistaPreset" />

                                <!-- EL CORTE POR UN EJE es un alzado: se ve solo lo
                                que hay sobre ese eje. En isometrica un edificio
                                de muros es una maraña; cortado se entiende. -->
                                <TextBlock Text="Corte:" FontSize="11.5" FontWeight="SemiBold"
                                VerticalAlignment="Center" Margin="14,0,6,0" />
                                <ComboBox x:Name="CorteEjeCombo" Width="150"
                                VerticalAlignment="Center"
                                SelectionChanged="OnCorteEjeCambiado" />
                                <TextBlock Text="Cada elemento con su seccion real y sombreado. Arrastra con el boton izquierdo para girar, con el derecho para mover, y la rueda hace zoom."
                                FontSize="10.5" Foreground="{DynamicResource MutedTextBrush}"
                                VerticalAlignment="Center" Margin="14,0,0,0"
                                TextWrapping="Wrap" MaxWidth="320" />
                                </StackPanel>
                            </StackPanel>

                            <TabControl x:Name="VistaTabs" Grid.Row="2" Grid.Column="1"
                                        Margin="8,0,0,0" HorizontalAlignment="Stretch"
                                        SelectionChanged="OnVistaTabCambiada">

                                <!-- Dentro de cada pestaña solo va SU LIENZO: los botones
                                     son los mismos para las dos y viven arriba. -->
                                <TabItem Header="Vista 3D">
                                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="3" Background="{DynamicResource SurfaceBrush}">
                                    <!-- El Background es imprescindible: sin el, el Canvas no
                                    recibe los eventos del mouse. -->
                                    <Canvas x:Name="Vista3DCanvas" Height="430" ClipToBounds="True"
                                    Background="{DynamicResource SurfaceBrush}"
                                    MouseLeftButtonDown="OnVistaMouseDown"
                                    MouseRightButtonDown="OnVistaMouseDown"
                                    MouseMove="OnVistaMouseMove"
                                    MouseLeftButtonUp="OnVistaMouseUp"
                                    MouseRightButtonUp="OnVistaMouseUp"
                                    MouseLeave="OnVistaMouseUp"
                                    MouseWheel="OnVistaWheel" />
                                    </Border>
                                </TabItem>

                                <TabItem Header="Vista extruida">
                                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="3" Background="{DynamicResource SurfaceBrush}">
                                    <Canvas x:Name="ExtruidaCanvas" Height="430" ClipToBounds="True"
                                    Background="{DynamicResource SurfaceBrush}"
                                    MouseLeftButtonDown="OnVistaMouseDown"
                                    MouseRightButtonDown="OnVistaMouseDown"
                                    MouseMove="OnVistaMouseMove"
                                    MouseLeftButtonUp="OnVistaMouseUp"
                                    MouseRightButtonUp="OnVistaMouseUp"
                                    MouseLeave="OnVistaMouseUp"
                                    MouseWheel="OnVistaWheel" />
                                    </Border>
                                </TabItem>
                            </TabControl>
                        </Grid>

                        <!-- La lectura del modelo y sus tablas: PLEGADAS, porque se usan una
                             vez al empezar y despues estorban. Antes eran una pestaña aparte
                             y habia que ir y volver por cada cambio. -->
                        <Expander Header="Lectura del modelo y tablas de elementos"
                                  FontWeight="SemiBold" Margin="0,0,0,10">
                            <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="Lectura del modelo de ETABS" Style="{StaticResource ModuleTitleStyle}"
                                   ToolTip="Se conecta a la sesion abierta de ETABS por la CSI OAPI, la misma interfaz COM que usa tu macro. No se controla por red." />

                        <Border Style="{StaticResource TarjetaStyle}"
                                Padding="16"
                                MaxWidth="720" HorizontalAlignment="Left" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Antes de conectar" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,6" />
                                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"
                                           Text="1. ETABS o SAP2000 abierto, con el modelo cargado.&#x0a;2. Sin cuadros de dialogo abiertos en el programa.&#x0a;3. El modelo guardado al menos una vez." />
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <!-- LA CASILLA DEL PROGRAMA: de aqui sale a quien se le habla, y
                                 manda para TODO lo de esta pestaña -probar la conexion, leer
                                 el modelo, leer los piers y armar los planos-. Antes habia un
                                 boton por programa y era facil pulsar el que no tocaba.

                                 Es una sola casilla porque el lector es UNO: CSI comparte la
                                 OAPI entre ETABS y SAP2000 -la misma cOAPI, el mismo SapModel
                                 y las mismas llamadas- y lo que cambia es el ProgID con el que
                                 se pide el objeto activo y la libreria que se carga. -->
                            <TextBlock Text="Programa:" FontWeight="SemiBold" FontSize="11.5"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox x:Name="ProgramaCsiCombo" Width="120" SelectedIndex="0"
                                      VerticalAlignment="Center" Margin="0,0,12,0"
                                      SelectionChanged="OnProgramaCsiCambiado"
                                      ToolTip="De donde se lee el modelo: de ETABS o de SAP2000.&#10;Vale para todos los botones de esta pestaña.">
                                <ComboBoxItem Content="ETABS" />
                                <ComboBoxItem Content="SAP2000" />
                            </ComboBox>

                            <Button Content="Probar conexion" Style="{StaticResource PrimaryButtonStyle}" Click="OnTestEtabs" />
                            <Button x:Name="LeerModeloCsiButton" Content="Leer modelo de ETABS"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="OnImportModeloCsi"
                                    ToolTip="Lee el modelo abierto en el programa de la casilla y lo muestra en el visor." />
                            <Button Content="Leer piers de muros" Style="{StaticResource SecondaryButtonStyle}"
                                    Click="OnLeerPiers"
                                    ToolTip="Lee las etiquetas de pier de los muros y sus medidas por nivel.&#10;En ETABS se asignan con Assign &gt; Shell &gt; Pier Label." />
                        </StackPanel>

                        <TextBlock x:Name="EtabsStatusText" FontSize="12" TextWrapping="Wrap" MaxWidth="760"
                                   FontFamily="Consolas"
                                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,14" />

                        
<!-- Los piers van en su propia tabla: son pier x nivel, no
                             elementos del modelo, y mezclarlos con los elementos
                             obligaria a columnas vacias en las dos. -->
                        <TextBlock x:Name="PiersTitulo" Text="Piers de muros" FontWeight="SemiBold"
                                   FontSize="12.5" Visibility="Collapsed"
                                   Margin="0,0,0,6" Foreground="{DynamicResource BrandDarkBrush}" />

                        <DataGrid x:Name="PiersGrid" Style="{StaticResource SheetGridStyle}"
                                  Height="200" IsReadOnly="True" CanUserAddRows="False"
                                  CanUserDeleteRows="False" Visibility="Collapsed"
                                  Margin="0,0,0,16">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Pier"     Binding="{Binding Nombre}" Width="120" />
                                <DataGridTextColumn Header="Nivel"    Binding="{Binding Story}" Width="120" />
                                <DataGridTextColumn Header="Largo m"  Binding="{Binding LargoBaseM, StringFormat=N3}" Width="90" />
                                <DataGridTextColumn Header="Espesor m" Binding="{Binding EspesorBaseM, StringFormat=N3}" Width="95" />
                                <DataGridTextColumn Header="Medidas"  Binding="{Binding Dimensiones}" Width="130" />
                                <DataGridTextColumn Header="Angulo"   Binding="{Binding AnguloEje, StringFormat=N1}" Width="80" />
                                <DataGridTextColumn Header="Material" Binding="{Binding Material}" Width="*" MinWidth="110" />
                                <DataGridTextColumn Header="Paños"    Binding="{Binding Areas}" Width="70" />
                            </DataGrid.Columns>
                        </DataGrid>
                    
                            </StackPanel>
                        </Expander>

                        <TextBlock x:Name="PlanoHintText" FontSize="11.5" Margin="0,12,0,0"
                                   TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                                   Text="Lee el modelo en la pestaña de ETABS y la planta aparece aquí. Con «Dibujar en AutoCAD» se manda a AutoCAD el nivel elegido, tal como se ve, en metros y repartido en capas por tipo de elemento." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            

            <!-- ===== Secciones del modelo (la hoja SECCIONES de la macro) ===== -->
            <TabItem Header="Secciones modelo">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="22">
                        <TextBlock Text="Secciones usadas en el modelo" Style="{StaticResource ModuleTitleStyle}"
                                   ToolTip="Es la hoja SECCIONES de tu macro: que secciones de ETABS o de SAP2000 se estan usando de verdad, cuantas veces y en que niveles." />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <!-- La misma casilla de las otras dos pestañas: la lectura es
                                 una sola y el programa elegido tambien. -->
                            <TextBlock Text="Programa:" FontWeight="SemiBold" FontSize="11.5"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox x:Name="ProgramaCsiSeccionesCombo" Width="120"
                                      VerticalAlignment="Center" Margin="0,0,12,0"
                                      SelectedIndex="{Binding SelectedIndex, ElementName=ProgramaCsiCombo, Mode=TwoWay}"
                                      ToolTip="De donde se lee el modelo. Es la misma casilla de la pestaña ETABS/SAP2000.">
                                <ComboBoxItem Content="ETABS" />
                                <ComboBoxItem Content="SAP2000" />
                            </ComboBox>

                            <Button x:Name="LeerSeccionesModeloButton" Content="Leer secciones de ETABS"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="OnLeerSeccionesModelo"
                                    ToolTip="Lee el modelo del programa de la casilla y arma la tabla.&#10;Si el modelo ya se leyo, la tabla se llena sola." />

                            <Button Content="Copiar la tabla" Style="{StaticResource SecondaryButtonStyle}"
                                    Click="OnCopiarSeccionesModelo"
                                    ToolTip="Copia la tabla al portapapeles, con tabuladores, para pegarla en Excel." />

                            <!-- TOTALES O INDIVIDUALES: las dos tablas salen del MISMO
                                 modelo y dicen lo mismo a dos niveles de detalle, asi que
                                 no se ensenan las dos a la vez -eso era ver doble-, sino
                                 la que se pida. El boton dice A DONDE se va, que es lo que
                                 espera quien lo pulsa. -->
                            <Button x:Name="AlternarSeccionesButton" Content="Ver individuales"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="OnAlternarSeccionesModelo"
                                    ToolTip="TOTALES: una linea por seccion, con cuantas hay, su longitud o su area y en que niveles.&#10;INDIVIDUALES: una linea por elemento del modelo, con su etiqueta y su largo." />

                            <TextBlock x:Name="SeccionesModeloResumenText" FontSize="11.5"
                                       VerticalAlignment="Center" Margin="14,0,0,0"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                        </StackPanel>

                        <!-- Los nombres de columna son los de la hoja SECCIONES, tal cual -->
                        <DataGrid x:Name="SeccionesModeloGrid" Style="{StaticResource SheetGridStyle}"
                                  ColumnHeaderStyle="{StaticResource EncabezadoHojaStyle}"
                                  IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                                  MinHeight="320" MaxHeight="520">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="TIPO" Binding="{Binding Tipo}" Width="110"
                                                    CellStyle="{StaticResource CeldaIdent}" />
                                <DataGridTextColumn Header="SECCION DE ETABS" Binding="{Binding Seccion}"
                                                    Width="260" CellStyle="{StaticResource CeldaIdent}" />
                                <DataGridTextColumn Header="FORMA" Binding="{Binding Forma}" Width="110"
                                                    CellStyle="{StaticResource CeldaGeom}" />
                                <DataGridTextColumn Header="MATERIAL" Binding="{Binding Material}" Width="120"
                                                    CellStyle="{StaticResource CeldaGeom}" />
                                <DataGridTextColumn Header="T3 PERALTE (cm)"
                                                    Binding="{Binding PeralteCm, StringFormat=N1}"
                                                    Width="115" CellStyle="{StaticResource CeldaGeom}" />
                                <DataGridTextColumn Header="T2 ANCHO / ESPESOR (cm)"
                                                    Binding="{Binding AnchoCm, StringFormat=N1}"
                                                    Width="160" CellStyle="{StaticResource CeldaGeom}" />
                                <DataGridTextColumn Header="TF (cm)"
                                                    Binding="{Binding PatinCm, StringFormat=N2}"
                                                    Width="80" CellStyle="{StaticResource CeldaEstribo}" />
                                <DataGridTextColumn Header="TW (cm)"
                                                    Binding="{Binding AlmaCm, StringFormat=N2}"
                                                    Width="80" CellStyle="{StaticResource CeldaEstribo}" />
                                <DataGridTextColumn Header="CANTIDAD" Binding="{Binding Cantidad}"
                                                    Width="90" CellStyle="{StaticResource CeldaAcabado}" />

                                <!-- LO QUE HAY DE CADA COSA. Un frame se mide por su LARGO
                                     y un shell por su AREA, asi que cada renglon llena una
                                     de las dos y la otra se queda en blanco. -->
                                <DataGridTextColumn Header="LONGITUD TOTAL (m)"
                                                    Binding="{Binding LongitudTotalM, StringFormat=N2}"
                                                    Width="140" CellStyle="{StaticResource CeldaLechoInf}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="ToolTip"
                                                    Value="Suma del largo REAL de las barras con esa seccion, en tres dimensiones.&#10;En muros y losas va en blanco: ahi se mide el area." />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="AREA TOTAL (m²)"
                                                    Binding="{Binding AreaTotalM2, StringFormat=N2}"
                                                    Width="130" CellStyle="{StaticResource CeldaLechoSup}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="ToolTip"
                                                    Value="Suma del area del paño de los shell -muros y losas- con esa propiedad.&#10;Es el area del plano del elemento: en un muro, que es vertical, el area en planta seria cero." />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="NIVELES" Binding="{Binding Niveles}"
                                                    Width="*" CellStyle="{StaticResource CeldaAcabado}" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- LA MISMA TABLA QUE ESTABA DEBAJO DEL VISOR 3D, movida aqui: es
                             el detalle -una linea por elemento- de lo que la de arriba
                             resume por seccion. Arranca oculta y la ensena el boton. -->
                        <TextBlock x:Name="ElementosTitulo" Visibility="Collapsed"
                                   Text="Elementos del modelo, uno por uno" FontWeight="SemiBold" FontSize="12.5"
                                   Margin="0,0,0,6" Foreground="{DynamicResource BrandDarkBrush}" />

                        <DataGrid x:Name="EtabsGrid" Style="{StaticResource SheetGridStyle}"
                                  Visibility="Collapsed"
                                  ColumnHeaderStyle="{StaticResource EncabezadoHojaStyle}"
                                  MinHeight="320" MaxHeight="520" IsReadOnly="True" CanUserAddRows="False"
                                  CanUserDeleteRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Clase"    Binding="{Binding Clase}" Width="95" />
                                <DataGridTextColumn Header="Nivel"    Binding="{Binding Story}" Width="110" />
                                <DataGridTextColumn Header="Etiqueta" Binding="{Binding Etiqueta}" Width="110" />
                                <DataGridTextColumn Header="Seccion"  Binding="{Binding Seccion}" Width="*" MinWidth="170" />
                                <DataGridTextColumn Header="Dimensiones" Binding="{Binding Dimensiones}" Width="130" />
                                <DataGridTextColumn Header="Largo m"  Binding="{Binding LargoM, StringFormat=N2}" Width="90" />
                            </DataGrid.Columns>
                        </DataGrid>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== ETABS ===== -->
            




            <!-- ===== Licencia ===== -->
            <TabItem Header="Licencia">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="22" MaxWidth="760" HorizontalAlignment="Left">
                        <TextBlock Text="Estado de la licencia" Style="{StaticResource ModuleTitleStyle}"
                                   ToolTip="Informacion que soporte puede pedirte para resolver cualquier problema de activacion." />

                        <Border Style="{StaticResource TarjetaStyle}"
                                Padding="16" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Tipo de licencia" FontWeight="SemiBold" Margin="0,0,0,7" />
                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="LicTierText" Margin="0,0,0,7" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Licenciado a" FontWeight="SemiBold" Margin="0,0,0,7" />
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="LicOrgText" TextWrapping="Wrap" Margin="0,0,0,7" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Vigencia" FontWeight="SemiBold" Margin="0,0,0,7" />
                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="LicExpiryText" Margin="0,0,0,7" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Proxima validacion" FontWeight="SemiBold" Margin="0,0,0,7" />
                                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="LicTokenExpiryText" Margin="0,0,0,7" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Modulos habilitados" FontWeight="SemiBold" Margin="0,0,0,7" />
                                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="LicFeaturesText" TextWrapping="Wrap" Margin="0,0,0,7" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Huella del equipo" FontWeight="SemiBold" />
                                <TextBox   Grid.Row="5" Grid.Column="1" x:Name="LicFingerprintText"
                                           IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                           FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />
                            </Grid>
                        </Border>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Revalidar ahora" Style="{StaticResource PrimaryButtonStyle}" Click="OnRevalidate" />
                            <Button Content="Copiar huella" Style="{StaticResource SecondaryButtonStyle}" Click="OnCopyFingerprint" />
                            <Button Content="Liberar este equipo" Style="{StaticResource SecondaryButtonStyle}" Click="OnDeactivate" />
                        </StackPanel>

                        <TextBlock x:Name="LicMessageText" FontSize="11.5" Margin="0,12,0,0"
                                   TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- ==================== Barra de estado ==================== -->
        <!-- Aqui aterrizo lo unico del cuadro azul que no estaba en otro sitio: el
             estado de la licencia y la version. Ocupan el alto que ya gastaba esta
             barra, asi que la ventana gano el alto entero del encabezado. -->
        <Border Grid.Row="3" Background="{DynamicResource TabStripBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" x:Name="StatusText" FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource MutedTextBrush}" />
                <TextBlock Grid.Column="1" x:Name="CountsText" FontSize="11"
                           Margin="12,0,0,0" Foreground="{DynamicResource MutedTextBrush}" />

                <TextBlock Grid.Column="2" x:Name="HeaderLicense" FontSize="11" FontWeight="SemiBold"
                           Margin="16,0,0,0" Foreground="{DynamicResource BrandDarkBrush}" />
                <TextBlock Grid.Column="3" x:Name="HeaderVersion" FontSize="11"
                           Margin="8,0,0,0" Foreground="{DynamicResource MutedTextBrush}" />
            </Grid>
        </Border>
    </Grid>
</Window>
