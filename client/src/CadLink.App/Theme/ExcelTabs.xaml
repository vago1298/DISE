<!--
    Pestañas al estilo de las hojas de Excel: en la parte inferior de la ventana,
    la activa en blanco con acento de color, las inactivas en gris.

    La idea es que el usuario reconozca de inmediato la metáfora: cada pestaña es
    una "hoja" independiente del programa.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:prim="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">

    <!-- ===================== Tipografia y medidas =====================
         El rediseno empieza aqui: antes cada estilo llevaba su tamano y su radio
         escritos a mano, asi que la ventana tenia botones de radio 3, pestanas de
         radio 4 y tarjetas de radio 4, con seis tamanos de letra sin relacion entre
         si. Con la escala en un solo sitio, todo el programa respira igual.

         La fuente es la de Windows 11 con la de siempre como respaldo: si el equipo
         no tiene la Variable, cae en Segoe UI y no en la fuente por omision de WPF,
         que es de los noventa. -->
    <FontFamily x:Key="FuenteUI">Segoe UI Variable Text, Segoe UI, Segoe UI Emoji</FontFamily>

    <CornerRadius x:Key="RadioChico">4</CornerRadius>
    <CornerRadius x:Key="RadioBoton">6</CornerRadius>
    <CornerRadius x:Key="RadioTarjeta">8</CornerRadius>
    <CornerRadius x:Key="RadioPestana">7,7,0,0</CornerRadius>

    <!-- ===================== Paleta ===================== -->
    <Color x:Key="BrandDarkColor">#FF0A2F4C</Color>
    <Color x:Key="BrandColor">#FF15679F</Color>

    <SolidColorBrush x:Key="BrandDarkBrush" Color="{StaticResource BrandDarkColor}" />
    <SolidColorBrush x:Key="BrandBrush" Color="{StaticResource BrandColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FFF2A32C" />

    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFFFF" />

    <!-- Fondo de la vista previa. Azul CLARO: el dibujo va en tinta oscura sobre
         concreto claro, asi que un azul fuerte dejaria las varillas, las cotas y
         el rayado del concreto sin contraste. -->
    <SolidColorBrush x:Key="PreviewFondoBrush" Color="#FFE8F1FA" />
    <SolidColorBrush x:Key="TabStripBrush" Color="#FFE8EEF5" />
    <SolidColorBrush x:Key="TabInactiveBrush" Color="#FFF5F8FB" />
    <SolidColorBrush x:Key="TabHoverBrush" Color="#FFE0E8F1" />
    <SolidColorBrush x:Key="BorderBrush" Color="#FFD7DFE9" />
    <SolidColorBrush x:Key="TextBrush" Color="#FF11202D" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#FF64748B" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FFC0392B" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FFB07908" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#FF1B7A33" />

    <!-- ===================== Paleta, segunda parte =====================
         Estas brochas se anadieron al montar el tema oscuro. Antes cada uno de
         estos colores estaba QUEMADO A MANO en el sitio donde se usaba, y el
         #FFF3F6F9 de las tarjetas estaba repetido ONCE VECES. Mientras el
         programa fue solo claro eso no molestaba; con dos temas es imposible,
         porque un literal no puede cambiar de valor.

         El tema se cambia MUTANDO EL COLOR de estas brochas, no sustituyendo el
         diccionario. Ver Tema.cs, que explica por que. -->

    <!-- Fondo de la ventana -->
    <SolidColorBrush x:Key="WindowBrush" Color="#FFF2F5F9" />

    <!-- Tarjetas: las cabeceras de cada hoja -->
    <SolidColorBrush x:Key="CardBrush" Color="#FFFAFCFE" />

    <!-- Barra de totales, debajo de la cuadricula -->
    <SolidColorBrush x:Key="TotalesBrush" Color="#FFEEF3F9" />

    <!-- Cuadricula: filas, alternas y lineas -->
    <SolidColorBrush x:Key="GridRowBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="GridAltRowBrush" Color="#FFF8FBFD" />
    <SolidColorBrush x:Key="GridLineBrush" Color="#FFE6EDF4" />
    <SolidColorBrush x:Key="HeaderBrush" Color="#FFE5ECF4" />

    <!-- Aviso amarillo de la barra de notificaciones -->
    <SolidColorBrush x:Key="NoticeFondoBrush" Color="#FFFFF6DC" />
    <SolidColorBrush x:Key="NoticeBordeBrush" Color="#FFE6C97A" />
    <SolidColorBrush x:Key="NoticeTextoBrush" Color="#FF7A5B00" />

    <!-- ===== Seleccion, foco y sombra =====
         Tres brochas del rediseno. Antes la fila seleccionada se pintaba con el azul
         del sistema -que no es el azul del programa- y no habia ni foco ni sombra:
         todo era plano y con el mismo borde gris.
         Van en la paleta y no escritas en el estilo por lo mismo que las demas: el
         tema oscuro tiene que poder cambiarlas. Ver Tema.cs. -->
    <SolidColorBrush x:Key="SelectionBrush" Color="#FFD6E8F7" />
    <SolidColorBrush x:Key="FocoBrush" Color="#FF15679F" />
    <SolidColorBrush x:Key="SombraBrush" Color="#FF0A2F4C" />

    <!-- Botones -->
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#FFA7B3C0" />
    <SolidColorBrush x:Key="ToolbarPressedBrush" Color="#FFD5DFEA" />

    <!-- ===================== Colores de celda =====================
         Sacados a brochas por lo mismo: en tema oscuro estos nueve pasteles
         sobre blanco no se leen. Los estilos de celda de mas abajo los usan en
         lugar de llevar el hex escrito. -->
    <SolidColorBrush x:Key="CeldaIdentBrush" Color="#FFDCE7F3" />
    <SolidColorBrush x:Key="CeldaGeomBrush" Color="#FFE6F2E1" />
    <SolidColorBrush x:Key="CeldaLechoSupBrush" Color="#FFDCEEF6" />
    <SolidColorBrush x:Key="CeldaLechoInfBrush" Color="#FFEFE8F6" />
    <SolidColorBrush x:Key="CeldaLateralBrush" Color="#FFFBF2D9" />
    <SolidColorBrush x:Key="CeldaCircularBrush" Color="#FFFBE4DE" />
    <SolidColorBrush x:Key="CeldaEstriboBrush" Color="#FFE9EEF2" />
    <SolidColorBrush x:Key="CeldaAcabadoBrush" Color="#FFF4F1E8" />
    <SolidColorBrush x:Key="CeldaCalculadaBrush" Color="#FFEDEDED" />

    <!-- ===== La fila de acero cuando el acero no se hace en ese perfil =====
         Tres brochas, no una, porque hay que decir tres cosas distintas:

           * FilaAceroNoDisponibleBrush  el fondo de TODA la fila, muy suave: es
             un aviso, no un error, y la fila se tiene que seguir leyendo.
           * AceroNoSeHaceBrush          la celda de disponibilidad, en rojo de
             verdad con texto blanco. Esta es la que dice QUE pasa, y va fuerte
             porque es la unica que lo dice.
           * AceroVerificarBrush         ambar: puede conseguirse, hay que
             confirmarlo. NO es rojo, y esa diferencia importa: pintar de rojo un
             acero que si se puede pedir hace cambiar de acero sin necesidad. -->
    <SolidColorBrush x:Key="FilaAceroNoDisponibleBrush" Color="#FFFBE3E3" />
    <SolidColorBrush x:Key="AceroNoSeHaceBrush" Color="#FFC62828" />
    <SolidColorBrush x:Key="AceroVerificarBrush" Color="#FFFFF1CC" />
    <SolidColorBrush x:Key="AceroVerificarTextoBrush" Color="#FF8A5A00" />

    <!-- ===================== Menú =====================
         Sin estos dos estilos el menú se queda con los colores por omisión de
         Windows —fondo claro y texto negro— y en tema oscuro era lo único que
         seguía saliendo blanco. Van SIN x:Key a propósito: así se aplican a
         todos los Menu y MenuItem de la ventana sin tener que tocarlos uno a uno. -->
    <Style TargetType="Menu">
        <Setter Property="Background" Value="{DynamicResource TabStripBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

    <!-- ===================== Casillas y opciones =====================
         Los RadioButton de «Sección tipo 1 / tipo 2» y los CheckBox salían con el
         texto NEGRO por omisión de Windows, así que en tema oscuro desaparecían
         sobre el fondo. Con la ventana clara no se notaba porque el negro es el
         color que tocaba. Van sin x:Key para que apliquen a todos. -->
    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="5,3" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource BrandBrush}" />
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource FocoBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
                <Setter Property="Background" Value="{DynamicResource WindowBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

    <!-- Y las etiquetas, por lo mismo. -->
    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

    <!-- ===================== Pestaña individual ===================== -->
    <Style x:Key="ExcelTabItemStyle" TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource FuenteUI}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="17,9" />
        <Setter Property="Margin" Value="0,0,3,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid>
                        <!-- Pestaña de tira SUPERIOR: el borde se abre por abajo,
                             hacia el contenido, y las esquinas se redondean arriba.
                             Cuando la tira estaba abajo era al contrario. -->
                        <Border x:Name="Bg"
                                Background="{DynamicResource TabInactiveBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1,1,1,0"
                                CornerRadius="{StaticResource RadioPestana}">
                            <ContentPresenter x:Name="Label"
                                              ContentSource="Header"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>

                        <!-- Barra de acento, arriba: es el borde que marca la hoja
                             activa. Oculta salvo en la pestaña seleccionada. -->
                        <Border x:Name="Accent"
                                Height="3"
                                VerticalAlignment="Top"
                                Background="{DynamicResource BrandBrush}"
                                CornerRadius="{StaticResource RadioPestana}"
                                Visibility="Collapsed" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SurfaceBrush}" />
                            <Setter TargetName="Bg" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="0"
                                                      Opacity="0.16" Color="#FF0A2F4C" />
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Accent" Property="Visibility" Value="Visible" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Foreground" Value="{DynamicResource BrandDarkBrush}" />
                            <Setter Property="Panel.ZIndex" Value="10" />
                        </Trigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="False" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource TabHoverBrush}" />
                        </MultiTrigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                            <Setter Property="Opacity" Value="0.55" />
                            <Setter Property="Cursor" Value="No" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Contenedor de pestañas ===================== -->
    <Style x:Key="ExcelTabControlStyle" TargetType="TabControl">
        <!-- ARRIBA, no abajo. Las hojas al estilo de Excel llevan la tira abajo,
             pero aqui hay 12 pestañas y con la tira abajo el usuario tenia que ir a
             buscarlas al pie de la ventana, lejos del menu y de la barra de
             herramientas con las que se combinan. -->
        <Setter Property="TabStripPlacement" Value="Top" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource ExcelTabItemStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Franja de pestañas.
                             ==============================================================
                             OJO: aquí NO va un TabPanel, y es a propósito.

                             El TabPanel de WPF, cuando las pestañas no caben en una fila,
                             REORDENA las filas para dejar la de la pestaña seleccionada
                             pegada al contenido. El resultado es que las pestañas SALTAN de
                             sitio cada vez que eliges una: pulsas «Placa Base» en la fila de
                             arriba y de pronto aparece abajo, con todo lo demás movido. Con
                             12 hojas eso pasa constantemente y obliga a buscar la pestaña
                             otra vez después de cada clic.

                             Un WrapPanel acomoda las pestañas en varias filas igual que el
                             TabPanel, pero conserva el ORDEN: cada hoja se queda siempre en
                             el mismo sitio, que es lo que se espera de una barra de
                             pestañas y lo que pidió el usuario.

                             Lo que se pierde es el efecto de «fila pegada al contenido». No
                             es un problema: la pestaña activa ya se distingue por su fondo
                             blanco, su barra de acento y su texto en negrita.
                             ============================================================== -->
                        <Border Grid.Row="0" Background="{DynamicResource TabStripBrush}" Padding="10,7,10,0">
                            <WrapPanel IsItemsHost="True" Orientation="Horizontal" />
                        </Border>

                        <!-- Contenido de la hoja activa. El borde va ARRIBA, contra la
                             tira, para que la hoja activa se lea unida a su pestaña. -->
                        <Border Grid.Row="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,1,0,0">
                            <ContentPresenter ContentSource="SelectedContent" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Estilos auxiliares ===================== -->
    <Style x:Key="ModuleTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FuenteUI}" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource BrandDarkBrush}" />
        <Setter Property="Margin" Value="0,2,0,2" />
    </Style>

    <!-- El subtitulo explica la hoja, asi que se lee de verdad: se le puso
         interlineado y un ancho maximo. Un parrafo de 1800 px de ancho no se lee,
         se salta. -->
    <Style x:Key="ModuleSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FuenteUI}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="MaxWidth" Value="1120" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!-- ===================== Botones =====================
         El PRIMARIO es el que dibuja: fondo de marca, sombra baja para que se
         levante del fondo y radio de 6. El SECUNDARIO ya no es un boton gris
         solido -competia con el primario y la hoja acababa con dos botones
         igual de fuertes-: ahora es de CONTORNO, que es lo que se espera de una
         accion que no es la principal.

         Los dos crecen a 32 px de alto minimo: es la altura comoda para el raton
         y la que hace que la fila de botones se lea como una sola pieza. -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource BrandBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontFamily" Value="{StaticResource FuenteUI}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource RadioBoton}"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect x:Name="Sombra" BlurRadius="8" ShadowDepth="1"
                                                  Direction="270" Opacity="0.20"
                                                  Color="#FF0A2F4C" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextBlock.FontWeight="{TemplateBinding FontWeight}" />
                        </Border>

                        <!-- Anillo de FOCO por teclado. Sin esto, quien navega con
                             Tab no sabe en que boton esta. -->
                        <Border x:Name="Foco"
                                BorderBrush="{DynamicResource FocoBrush}"
                                BorderThickness="2"
                                CornerRadius="{StaticResource RadioBoton}"
                                Margin="-3"
                                Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrandDarkBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrandDarkBrush}" />
                            <Setter TargetName="Bd" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="0" ShadowDepth="0" Opacity="0" />
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Bd" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform Y="1" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Foco" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TabHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
                            <Setter Property="Cursor" Value="No" />
                            <Setter TargetName="Bd" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="0" ShadowDepth="0" Opacity="0" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- El de CONTORNO: la accion de apoyo -revisar, comprobar- con el mismo
         tamano que el primario pero sin peso visual. -->
    <Style x:Key="SecondaryButtonStyle" TargetType="Button"
           BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource BrandDarkBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadioBoton}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="Foco"
                                BorderBrush="{DynamicResource FocoBrush}"
                                BorderThickness="2"
                                CornerRadius="{StaticResource RadioBoton}"
                                Margin="-3"
                                Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TabHoverBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrandBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ToolbarPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Foco" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource WindowBrush}" />
                            <Setter Property="Cursor" Value="No" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Celda con lista desplegable, como la validación de datos de Excel.
         IsDropDownOpen en True hace que la lista se abra en cuanto la celda entra
         en edición, en lugar de exigir un segundo clic en la flechita. -->
    <Style x:Key="ComboCeldaEdicion" TargetType="ComboBox">
        <Setter Property="IsDropDownOpen" Value="True" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="2,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="ComboCeldaLectura" TargetType="TextBlock">
        <Setter Property="Padding" Value="4,3" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Cuadrícula con aire de hoja de cálculo: encabezados grises, líneas suaves,
         filas alternadas y edición directa. -->
    <Style x:Key="SheetGridStyle" TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="True" />
        <Setter Property="CanUserDeleteRows" Value="True" />
        <Setter Property="HeadersVisibility" Value="All" />
        <Setter Property="GridLinesVisibility" Value="All" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource GridLineBrush}" />
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource GridLineBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="RowBackground" Value="{DynamicResource GridRowBrush}" />
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource GridAltRowBrush}" />
        <Setter Property="SelectionUnit" Value="CellOrRowHeader" />
        <Setter Property="FontFamily" Value="{StaticResource FuenteUI}" />
        <Setter Property="FontSize" Value="12" />

        <!-- Aire dentro de la cuadricula: 26 px de fila y 32 de encabezado. Con las
             filas apretadas de antes, veinte renglones de captura se leian como un
             muro de numeros. -->
        <Setter Property="RowHeight" Value="26" />
        <Setter Property="ColumnHeaderHeight" Value="32" />
        <Setter Property="RowHeaderWidth" Value="22" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource GridLineBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ==================================================================
         Colores de celda por grupo de columnas
         ==================================================================
         Con 27 columnas seguidas, todas del mismo color, es muy facil escribir
         el armado del lecho inferior en el del superior: las cabeceras se
         parecen y no hay nada que separe un grupo del siguiente. Los colores
         hacen ese trabajo, igual que en la hoja de Excel original.

         Los tonos van MUY suaves a proposito: tienen que separar grupos sin
         competir con la seleccion de fila ni con el texto.

         Cada estilo hereda del DataGridCell de serie, asi que el resaltado de
         seleccion sigue funcionando: el trigger IsSelected del estilo base gana
         al Setter de fondo. Sin el BasedOn se perderia el resaltado y no se
         veria que fila esta seleccionada. -->

    <Style x:Key="CeldaBase" TargetType="DataGridCell"
           BasedOn="{StaticResource {x:Type DataGridCell}}">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="FontFamily" Value="{StaticResource FuenteUI}" />

        <!-- LA SELECCION, CON EL AZUL DEL PROGRAMA.
             Antes la pintaba Windows con su azul de sistema, que tapaba el color del
             grupo de columnas y dejaba el texto en blanco sobre un fondo que no es de
             aqui. Ahora es un azul claro de la propia paleta: se ve que la fila esta
             elegida y se sigue leyendo el dato. -->
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Identificacion: que elemento es y como se llama su bloque -->
    <Style x:Key="CeldaIdent" TargetType="DataGridCell" BasedOn="{StaticResource CeldaBase}">
        <Setter Property="Background" Value="{StaticResource CeldaIdentBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Geometria: base y altura -->
    <Style x:Key="CeldaGeom" TargetType="DataGridCell" BasedOn="{StaticResource CeldaBase}">
        <Setter Property="Background" Value="{StaticResource CeldaGeomBrush}" />
    </Style>

    <!-- Lecho superior -->
    <Style x:Key="CeldaLechoSup" TargetType="DataGridCell" BasedOn="{StaticResource CeldaBase}">
        <Setter Property="Background" Value="{StaticResource CeldaLechoSupBrush}" />
    </Style>

    <!-- Lecho inferior. Distinto del superior, que es justo el par que se
         confunde al capturar. -->
    <Style x:Key="CeldaLechoInf" TargetType="DataGridCell" BasedOn="{StaticResource CeldaBase}">
        <Setter Property="Background" Value="{StaticResource CeldaLechoInfBrush}" />
    </Style>

    <!-- Varillas laterales -->
    <Style x:Key="CeldaLateral" TargetType="DataGridCell" BasedOn="{StaticResource CeldaBase}">
        <Setter Property="Background" Value="{StaticResource CeldaLateralBrush}" />
    </Style>

    <!-- Seccion circular: armado del circulo y forma del zuncho -->
    <Style x:Key="CeldaCircular" TargetType="DataGridCell" BasedOn="{StaticResource CeldaBase}">
        <Setter Property="Background" Value="{StaticResource CeldaCircularBrush}" />
    </Style>

    <!-- ==============================================================
         CELDAS QUE SOLO APLICAN CON UN TIPO DE MURO
         (hoja de zapatas corridas)

         Una zapata con muro de MAMPOSTERIA no tiene armado de muro, y una
         con muro de CONCRETO no lleva cadena de desplante: sus macros ni
         las leen. Dejar la casilla escribible invita a capturar un dato
         que el dibujo va a ignorar, y despues a no entender por que no
         sale en el plano.

         Se apaga con IsEnabled enlazado a la propia fila -el DataContext
         de una celda ES su fila-, asi que la casilla se enciende y se
         apaga sola al cambiar el tipo de muro, sin una linea de codigo.
         La opacidad es para que se vea apagada y no solo intocable.
         ============================================================== -->
    <Style x:Key="CeldaSoloMamposteria" TargetType="DataGridCell"
           BasedOn="{StaticResource CeldaIdent}">
        <Setter Property="IsEnabled" Value="{Binding MuroEsMamposteria}" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CeldaSoloConcreto" TargetType="DataGridCell"
           BasedOn="{StaticResource CeldaLateral}">
        <Setter Property="IsEnabled" Value="{Binding MuroEsConcreto}" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Acero transversal: recubrimiento, estribo, separacion, diamante -->
    <Style x:Key="CeldaEstribo" TargetType="DataGridCell" BasedOn="{StaticResource CeldaBase}">
        <Setter Property="Background" Value="{StaticResource CeldaEstriboBrush}" />
    </Style>

    <!-- Acabado: gancho, f'c, escala, longitud -->
    <Style x:Key="CeldaAcabado" TargetType="DataGridCell" BasedOn="{StaticResource CeldaBase}">
        <Setter Property="Background" Value="{StaticResource CeldaAcabadoBrush}" />
    </Style>

    <!-- Calculadas: de solo lectura. Van en gris y en cursiva para que se vea de
         un golpe que ahi no se escribe. -->
    <Style x:Key="CeldaCalculada" TargetType="DataGridCell" BasedOn="{StaticResource CeldaBase}">
        <Setter Property="Background" Value="{StaticResource CeldaCalculadaBrush}" />
        <Setter Property="FontStyle" Value="Italic" />
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    </Style>

    <!-- ==================================================================
         La fila de acero: marcada cuando el acero no se hace en ese perfil
         ==================================================================
         El manual dice, acero por acero, en qué secciones se consigue. Un A-36
         en un monten no existe —la lámina rolada en frío no se hace en A-36— y
         eso no se ve mirando la fila: los dos son valores válidos por separado.

         Así que la fila se marca. El fondo va MUY suave, porque es un aviso y no
         un error: el dibujo se puede generar igual, lo que hace falta es que el
         calculista lo vea antes de mandar el plano.

         Se pone TAMBIÉN el ToolTip en la fila, con el detalle: qué acero es, su
         Fy y su Fu, para no tener que ir a buscarlo a otra parte. -->
    <Style x:Key="FilaAceroStyle" TargetType="DataGridRow"
           BasedOn="{StaticResource {x:Type DataGridRow}}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding AceroNoDisponible}" Value="True">
                <Setter Property="Background"
                        Value="{StaticResource FilaAceroNoDisponibleBrush}" />
                <Setter Property="ToolTip"
                        Value="{Binding AceroDetalle}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- La celda que DICE qué pasa. Es la que va fuerte, y la única.

         Va con su propio estilo y no con el color de la fila porque el fondo de
         la fila puede perder contra el AlternatingRowBackground de la
         cuadrícula, según la versión de WPF. Esta celda no depende de eso: su
         color es suyo, así que el aviso se ve siempre. -->
    <Style x:Key="CeldaDisponibilidadAcero" TargetType="DataGridCell"
           BasedOn="{StaticResource CeldaBase}">
        <Setter Property="Background" Value="{StaticResource CeldaCalculadaBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="11" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding AceroNoDisponible}" Value="True">
                <Setter Property="Background" Value="{StaticResource AceroNoSeHaceBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
            <DataTrigger Binding="{Binding AceroPorVerificar}" Value="True">
                <Setter Property="Background" Value="{StaticResource AceroVerificarBrush}" />
                <Setter Property="Foreground"
                        Value="{StaticResource AceroVerificarTextoBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Encabezado de la hoja: se queda fijo arriba y con aire suficiente para
         que los nombres de dos palabras se lean. -->
    <Style x:Key="EncabezadoHojaStyle" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource HeaderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource BrandDarkBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource FuenteUI}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Padding" Value="8,7" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Grid>
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,0,1,0">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>

                        <!-- La LINEA DE MARCA que cierra la cabecera por abajo. Es
                             lo que separa de un golpe de vista los titulos de los
                             datos: antes la cabecera y la primera fila se tocaban
                             con la misma linea gris que el resto de la cuadricula. -->
                        <Border Height="2" VerticalAlignment="Bottom"
                                Background="{DynamicResource BrandBrush}"
                                Opacity="0.55" />

                        <Thumb x:Name="PART_RightHeaderGripper"
                               HorizontalAlignment="Right"
                               Width="6" Cursor="SizeWE" Opacity="0">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================================================================
         Barra de herramientas de arriba
         ==================================================================
         Un boton de barra NO se pinta como los de dentro de las hojas: va
         plano, sin fondo hasta que el raton pasa por encima, que es como se
         comporta la barra de cualquier programa de Windows. Usar aqui el
         PrimaryButtonStyle dejaria una fila de botones azules gritando en lo
         alto de la ventana. -->
    <Style x:Key="ToolbarButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="11,6" />
        <Setter Property="Margin" Value="0,0,2,0" />
        <Setter Property="FontFamily" Value="{StaticResource FuenteUI}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource RadioChico}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TabHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ToolbarPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- El de la accion principal de la barra, «Guardar»: mismo tamaño y misma
         forma que los demas, pero con el color de marca, para que se distinga de
         un golpe de vista sin romper la barra. -->
    <Style x:Key="ToolbarPrimaryButtonStyle" TargetType="Button"
           BasedOn="{StaticResource ToolbarButtonStyle}">
        <Setter Property="Foreground" Value="{DynamicResource BrandDarkBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- ==================================================================
         LAS TRES PIEZAS DEL REDISENO QUE ANTES SE ESCRIBIAN A MANO
         ==================================================================
         Las tarjetas de cabecera, el marco de la vista previa y la barra de
         totales estaban puestos Border por Border en cada hoja, con su fondo,
         su borde y su radio repetidos DOCENAS de veces y no siempre iguales:
         habia tarjetas de radio 4 y de radio 0, y marcos de previa con borde
         azul de 1 px pegado al dibujo.

         Ahora son tres estilos. Cambiar el aire de todas las hojas es cambiar
         estos tres sitios, y ninguna hoja se puede quedar descolgada. -->

    <!-- Tarjeta: la caja donde vive cada grupo de ajustes de una hoja -->
    <Style x:Key="TarjetaStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadioTarjeta}" />
        <Setter Property="Padding" Value="14,11" />
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Marco de la vista previa: el dibujo va sobre papel claro, con el marco
         redondeado y sin el borde de color, que competia con las cotas. -->
    <Style x:Key="MarcoPreviaStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PreviewFondoBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadioTarjeta}" />
        <Setter Property="Margin" Value="0,10,0,0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Direction="270"
                                  Opacity="0.10" Color="#FF0A2F4C" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Barra de totales: cierra la cuadricula por abajo -->
    <Style x:Key="BarraTotalesStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource TotalesBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1,0,1,1" />
        <Setter Property="CornerRadius" Value="0,0,6,6" />
        <Setter Property="Padding" Value="13,8" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- El texto de la barra de totales -->
    <Style x:Key="TextoTotalesStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FuenteUI}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource BrandDarkBrush}" />
    </Style>

    <!-- Separador vertical de la barra, para agrupar acciones -->
    <Style x:Key="ToolbarSeparatorStyle" TargetType="Border">
        <Setter Property="Width" Value="1" />
        <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
        <Setter Property="Margin" Value="7,5,7,5" />
    </Style>

</ResourceDictionary>
