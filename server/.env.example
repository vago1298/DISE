# ---------------------------------------------------------------------------
# Copia este archivo a .env y ajusta los valores. NUNCA subas .env al repo.
# ---------------------------------------------------------------------------

# Identidad mostrada en el splash de las PCs internas
# Vacio = no se muestra ningun nombre de empresa. Lo que se ve en pantalla lo
# manda "nombreEmpresa" de cadlink.config.json, en el cliente.
ORG_NAME=""

# Base de datos. SQLite es suficiente para miles de equipos.
# Para producción con respaldos automáticos considera PostgreSQL:
#   DATABASE_URL="postgresql+psycopg://usuario:clave@host:5432/cadlink"
DATABASE_URL="sqlite:///./cadlink.db"

# Llaves RSA. Genéralas con scripts/generate_keys.sh
# La privada SOLO existe aquí. Protege este archivo (chmod 600).
PRIVATE_KEY_PATH="./keys/private.pem"

# ---------------------------------------------------------------------------
# Auto-inscripción de PCs internas
# ---------------------------------------------------------------------------
# SID del dominio de Active Directory de tu oficina.
# Obtenlo en cualquier PC del dominio con PowerShell:
#     (Get-ADDomain).DomainSID.Value
# o sin RSAT instalado:
#     wmic useraccount where "localaccount=0" get sid
#     (toma el prefijo S-1-5-21-x-y-z, sin el último bloque)
#
# DÉJALO VACÍO si tu oficina no tiene dominio de Active Directory.
# En ese caso registra las huellas de tus PCs a mano con scripts/register_machine.py
INTERNAL_DOMAIN_SID=""

# Tope de equipos internos gratuitos. Si se excede, el servidor rechaza la
# auto-inscripción y te avisa en el log de auditoría en lugar de regalar licencias.
INTERNAL_SEATS=30

# ---------------------------------------------------------------------------
# Vigencias
# ---------------------------------------------------------------------------
# TTL del token en días. Controla cada cuánto un equipo debe ver el servidor,
# y por lo tanto qué tan rápido surte efecto una revocación.
TOKEN_TTL_INTERNAL_DAYS=30
TOKEN_TTL_COMMERCIAL_DAYS=7
TOKEN_TTL_TRIAL_DAYS=7

# Días que la aplicación sigue funcionando sin conexión DESPUÉS de que el token
# expiró. Generoso a propósito: los ingenieros trabajan en obra y en plantas.
GRACE_DAYS_INTERNAL=21
GRACE_DAYS_COMMERCIAL=14
GRACE_DAYS_TRIAL=0

# Duración de la prueba gratuita para equipos externos desconocidos, en días.
# 1 = el prospecto puede probarlo un día y ya.
TRIAL_DAYS=1

# Pon en false si NO quieres que equipos desconocidos obtengan prueba automática
# (entonces todo externo requiere una clave de licencia que tú emitas)
ALLOW_AUTO_TRIAL=true

# El PRIMER equipo que se active recibe licencia INTERNA PERMANENTE.
# Sirve para tu propia máquina: instalas, abres la aplicación y queda perpetua.
# Solo se dispara si la base no tiene ningún equipo, así que ocurre una sola vez.
#
# ⚠️ Ponlo en false ANTES de exponer el servidor a internet, para que un
# desconocido no pueda ser "el primero".
AUTO_INTERNAL_FIRST_MACHINE=true

# ---------------------------------------------------------------------------
# Administración
# ---------------------------------------------------------------------------
# Clave para los endpoints /admin/*. Genera una larga y aleatoria:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_API_KEY="cambia-esto-por-una-clave-larga-y-aleatoria"

# Secreto compartido con tu pasarela de pagos para validar webhooks
PAYMENT_WEBHOOK_SECRET="cambia-esto-tambien"
