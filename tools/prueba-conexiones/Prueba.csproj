<Project Sdk="Microsoft.NET.Sdk">

  <!-- Prueba EJECUTABLE de las conexiones de acero leidas del libro de Excel.

       Corre en cualquier maquina: CadLink.Revit.Nucleo es net8.0 y lee el .xlsm con
       System.IO.Compression, sin Excel.

           cd tools/prueba-conexiones
           dotnet run
           dotnet run (con la ruta de un libro y una carpeta de salida: ademas lee
           ese libro y escribe sus vistas en JSON)

       Que comprueba:
         - el lector: textos compartidos, en linea y de formula, numeros, filas que se
           mueven, etiquetas repetidas (el Ry de la viga y el de la columna) y copias de
           hojas («PLACA GUSSET 2»);
         - las piezas de cada tipo de conexion con las medidas de la hoja;
         - que cada vista se proyecta sin numeros raros.

       Devuelve 0 si todo pasa y 1 si algo falla. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>CadLink.Pruebas</RootNamespace>
    <AssemblyName>prueba-conexiones</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\client\src\CadLink.Revit.Nucleo\CadLink.Revit.Nucleo.csproj" />
  </ItemGroup>

</Project>
